diff --git a/e2e/post.spec.ts b/e2e/post.spec.ts
new file mode 100644
index 0000000..7027517
--- /dev/null
+++ b/e2e/post.spec.ts
@@ -0,0 +1,51 @@
+import { expect, test } from "@playwright/test";
+
+// One behavior per test, read as a reader driving the browser — see
+// playwright.config.ts for the server these run against. Accept-Language is
+// controlled through the context's `locale`, not `setExtraHTTPHeaders`:
+// Chromium manages that header itself and ignores an extra-header override.
+
+test("visiting a post with an accept-language exact match renders that translation", async ({
+	browser,
+}) => {
+	const page = await (await browser.newContext({ locale: "en-US" })).newPage();
+
+	await page.goto("/posts/hello-world");
+
+	await expect(page.getByRole("heading", { level: 1 })).toHaveText(
+		"Hello, world",
+	);
+	await expect(page.getByText("A short note about this blog.")).toBeVisible();
+});
+
+test("visiting a post whose accepted locales match nothing renders its default-locale translation", async ({
+	browser,
+}) => {
+	const page = await (await browser.newContext({ locale: "fr-FR" })).newPage();
+
+	await page.goto("/posts/hello-world");
+
+	await expect(page.getByRole("heading", { level: 1 })).toHaveText(
+		"はじめまして",
+	);
+});
+
+test("visiting a post whose default locale only has a language-only translation still renders it", async ({
+	browser,
+}) => {
+	const page = await (await browser.newContext({ locale: "fr-FR" })).newPage();
+
+	await page.goto("/posts/on-writing-in-two-languages");
+
+	await expect(page.getByRole("heading", { level: 1 })).toHaveText(
+		"二言語で書くということ",
+	);
+});
+
+test("visiting a post with no translations at all renders the not-found page", async ({
+	page,
+}) => {
+	const response = await page.goto("/posts/draft-notes");
+
+	expect(response?.status()).toBe(404);
+});
diff --git a/shared/resolve-translation.spec.ts b/shared/resolve-translation.spec.ts
new file mode 100644
index 0000000..99e2d7e
--- /dev/null
+++ b/shared/resolve-translation.spec.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "@jest/globals";
+import type { Post } from "./resolve-translation";
+import { resolveTranslation } from "./resolve-translation";
+
+function post(overrides: Partial<Post> = {}): Post {
+	return {
+		slug: "test-post",
+		defaultLocale: "ja-JP",
+		translations: [
+			{ locale: "ja-JP", title: "ja-JP title", body: "ja-JP body" },
+			{ locale: "en-US", title: "en-US title", body: "en-US body" },
+		],
+		...overrides,
+	};
+}
+
+describe("resolveTranslation", () => {
+	it("prefers an exact match on the first accepted locale", () => {
+		const translation = resolveTranslation(post(), ["en-US", "ja-JP"]);
+
+		expect(translation?.locale).toBe("en-US");
+	});
+
+	it("falls back to a language-only match when no accepted locale matches exactly", () => {
+		const translation = resolveTranslation(post(), ["en-GB"]);
+
+		expect(translation?.locale).toBe("en-US");
+	});
+
+	it("tries every accepted locale for an exact match before trying any language match", () => {
+		const translation = resolveTranslation(
+			post({
+				translations: [
+					{ locale: "en", title: "en title", body: "en body" },
+					{ locale: "fr-FR", title: "fr-FR title", body: "fr-FR body" },
+				],
+			}),
+			["en-US", "fr-FR"],
+		);
+
+		expect(translation?.locale).toBe("fr-FR");
+	});
+
+	it("falls back to an exact match on the post's default locale", () => {
+		const translation = resolveTranslation(post(), ["de-DE"]);
+
+		expect(translation?.locale).toBe("ja-JP");
+	});
+
+	it("falls back to a language match on the post's default locale when no exact match exists", () => {
+		const translation = resolveTranslation(
+			post({
+				defaultLocale: "ja-JP",
+				translations: [{ locale: "ja", title: "ja title", body: "ja body" }],
+			}),
+			["de-DE"],
+		);
+
+		expect(translation?.locale).toBe("ja");
+	});
+
+	it("falls back to the default locale when no locales are accepted at all", () => {
+		const translation = resolveTranslation(post(), []);
+
+		expect(translation?.locale).toBe("ja-JP");
+	});
+
+	it("returns null when the post has no translations", () => {
+		const translation = resolveTranslation(post({ translations: [] }), [
+			"en-US",
+		]);
+
+		expect(translation).toBeNull();
+	});
+
+	it("returns null when nothing accepted matches and the default locale has no translation either", () => {
+		const translation = resolveTranslation(
+			post({
+				defaultLocale: "fr-FR",
+				translations: [
+					{ locale: "ja-JP", title: "ja-JP title", body: "ja-JP body" },
+				],
+			}),
+			["de-DE"],
+		);
+
+		expect(translation).toBeNull();
+	});
+});
