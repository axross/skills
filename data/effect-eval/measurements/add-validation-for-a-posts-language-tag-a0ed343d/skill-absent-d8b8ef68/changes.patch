@@ -0,0 +1,18 @@
+import { z } from "zod";
+
+/**
+ * Shape of a post's locale tag: a lowercase ISO 639-1 language subtag, alone
+ * or paired with a hyphen and an uppercase ISO 3166-1 region subtag —
+ * `"ja"`, `"ja-JP"`, `"en-US"`. This is the subset of BCP 47 this project's
+ * translations use ({@link PostTranslation.locale} and
+ * {@link Post.defaultLocale} in `resolve-translation.ts`), named here so a
+ * new locale tag is checked against one shape instead of being free-form
+ * text that merely resembles the others already in the catalog.
+ */
+export const PostLocale = z.string().regex(/^[a-z]{2}(-[A-Z]{2})?$/);
+
+export type PostLocale = z.infer<typeof PostLocale>;
+
+/** Message shown next to a locale field that failed {@link PostLocale}. */
+export const LOCALE_VALIDATION_MESSAGE =
+	'Use a language code, optionally with a region, e.g. "ja" or "ja-JP".';
