@@ -0,0 +1,33 @@
+import { describe, expect, it } from "@jest/globals";
+import { PostLocale } from "./post-locale";
+
+describe("PostLocale", () => {
+	it("accepts a bare language subtag", () => {
+		expect(PostLocale.safeParse("ja").success).toBe(true);
+		expect(PostLocale.safeParse("en").success).toBe(true);
+	});
+
+	it("accepts a language subtag paired with a region", () => {
+		expect(PostLocale.safeParse("ja-JP").success).toBe(true);
+		expect(PostLocale.safeParse("en-US").success).toBe(true);
+	});
+
+	it("rejects a region-only or wrong-cased tag", () => {
+		expect(PostLocale.safeParse("JP").success).toBe(false);
+		expect(PostLocale.safeParse("JA-JP").success).toBe(false);
+		expect(PostLocale.safeParse("ja-jp").success).toBe(false);
+		expect(PostLocale.safeParse("Ja-JP").success).toBe(false);
+	});
+
+	it("rejects an underscore-separated tag", () => {
+		expect(PostLocale.safeParse("ja_JP").success).toBe(false);
+	});
+
+	it("rejects a three-letter language code", () => {
+		expect(PostLocale.safeParse("jpn").success).toBe(false);
+	});
+
+	it("rejects an empty tag", () => {
+		expect(PostLocale.safeParse("").success).toBe(false);
+	});
+});
