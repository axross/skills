@@ -0,0 +1,17 @@
+import { z } from "zod";
+
+/**
+ * Shape of a post's locale tag: a lowercase 2-3 letter language subtag,
+ * optionally followed by a hyphen and an uppercase 2-letter region subtag —
+ * e.g. `"ja"`, `"en-US"`, `"ja-JP"`. This is the subset of BCP 47 this
+ * project actually uses (see `shared/resolve-translation.ts`); it exists so
+ * every locale tag is written the same way rather than each post inventing
+ * its own casing or separator.
+ */
+export const PostLocale = z.string().regex(/^[a-z]{2,3}(-[A-Z]{2})?$/);
+
+export type PostLocale = z.infer<typeof PostLocale>;
+
+/** Message shown next to a locale field that failed {@link PostLocale}. */
+export const LOCALE_VALIDATION_MESSAGE =
+	'Use a language subtag, optionally with a region (e.g. "ja" or "en-US").';
