@@ -0,0 +1,69 @@
+import { render, screen } from "@testing-library/react-native";
+
+import { AuthenticatedLayout } from "./authenticated-layout";
+
+const mockUseSession = jest.fn();
+const mockRedirect = jest.fn();
+let mockPathname = "/";
+
+jest.mock("./session-context", () => ({
+  useSession: () => mockUseSession(),
+}));
+
+jest.mock("expo-router", () => ({
+  usePathname: () => mockPathname,
+  Redirect: ({ href }: { href: unknown }) => {
+    mockRedirect(href);
+    return null;
+  },
+  Stack: () => null,
+}));
+
+beforeEach(() => {
+  mockUseSession.mockReset();
+  mockRedirect.mockReset();
+  mockPathname = "/";
+});
+
+describe("AuthenticatedLayout", () => {
+  it("shows a loading state while the session is still resolving", async () => {
+    mockUseSession.mockReturnValue({ session: null, status: "loading" });
+
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("loading-indicator")).toBeOnTheScreen();
+    expect(mockRedirect).not.toHaveBeenCalled();
+  });
+
+  it("sends a signed-out learner to sign-in with no destination when they were already at the deck list", async () => {
+    mockUseSession.mockReturnValue({ session: null, status: "ready" });
+    mockPathname = "/";
+
+    await render(<AuthenticatedLayout />);
+
+    expect(mockRedirect).toHaveBeenCalledWith("/sign-in");
+  });
+
+  it("carries the deck a signed-out learner was headed to through sign-in", async () => {
+    mockUseSession.mockReturnValue({ session: null, status: "ready" });
+    mockPathname = "/decks/world-capitals";
+
+    await render(<AuthenticatedLayout />);
+
+    expect(mockRedirect).toHaveBeenCalledWith({
+      pathname: "/sign-in",
+      params: { next: "/decks/world-capitals" },
+    });
+  });
+
+  it("renders the signed-in stack once a session is present", async () => {
+    mockUseSession.mockReturnValue({
+      session: { accountId: "local-1", email: "person@example.com" },
+      status: "ready",
+    });
+
+    await render(<AuthenticatedLayout />);
+
+    expect(mockRedirect).not.toHaveBeenCalled();
+  });
+});
