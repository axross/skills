+/** Shown when a post's slug doesn't match anything in the catalog, or when it does but has no translation to fall back to. */
+export default function PostNotFound() {
+	return (
+		<article>
+			<h1>No post here</h1>
+			<p>
+				There's no post at this address — maybe the link is wrong, or maybe it
+				hasn't been written yet.
+			</p>
+		</article>
+	);
+}
