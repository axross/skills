diff --git a/jest.config.js b/jest.config.js
index 5aba31c..721fc7f 100644
--- a/jest.config.js
+++ b/jest.config.js
@@ -19,4 +19,14 @@ module.exports = {
   moduleNameMapper: {
     "^@/(.*)$": "<rootDir>/src/$1",
   },
+  // jest-expo's default transformIgnorePatterns skips node_modules other
+  // than a fixed allowlist of RN-flavoured packages, which leaves out
+  // nanoid — an ESM-only package Jest otherwise can't parse. Reinstating
+  // that allowlist with nanoid added lets Jest transform it like any other
+  // source file instead of erroring on its `import`.
+  transformIgnorePatterns: [
+    "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|nanoid))",
+    "/node_modules/react-native-reanimated/plugin/",
+    "/node_modules/@react-native/babel-preset/",
+  ],
 };
