+import { QueryClient } from "@tanstack/react-query";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Post } from "../../types";
+import { getPostListQueryOptions } from "./post-list-query";
+import { getPostQueryOptions } from "./post-query";
+import { getPostSaveMutationOptions } from "./post-save-mutation";
+
+function post(overrides: Partial<Post> = {}): Post {
+  return {
+    id: 1,
+    siteId: 1,
+    title: "Original title",
+    slug: "original-title",
+    body: "Original body",
+    status: "draft",
+    createdAt: "2026-08-01T00:00:00.000Z",
+    updatedAt: "2026-08-01T00:00:00.000Z",
+    ...overrides,
+  };
+}
+
+describe("getPostSaveMutationOptions", () => {
+  let queryClient: QueryClient;
+
+  beforeEach(() => {
+    queryClient = new QueryClient();
+    vi.stubGlobal("fetch", vi.fn());
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("patches the site's post list cache so the list reflects the saved title and timestamp", async () => {
+    queryClient.setQueryData(getPostListQueryOptions("acme").queryKey, [
+      post({ id: 1, title: "Original title" }),
+      post({ id: 2, title: "A different post" }),
+    ]);
+
+    const saved = post({ id: 1, title: "Updated title", updatedAt: "2026-08-12T00:00:00.000Z" });
+    vi.mocked(fetch).mockResolvedValue(new Response(JSON.stringify(saved), { status: 200 }));
+
+    await queryClient
+      .getMutationCache()
+      .build(queryClient, getPostSaveMutationOptions("acme", 1))
+      .execute({ title: "Updated title", body: "Original body" });
+
+    expect(queryClient.getQueryData(getPostListQueryOptions("acme").queryKey)).toEqual([
+      saved,
+      post({ id: 2, title: "A different post" }),
+    ]);
+    expect(queryClient.getQueryData(getPostQueryOptions("acme", 1).queryKey)).toEqual(saved);
+  });
+
+  it("leaves the list cache untouched when it hasn't been fetched yet", async () => {
+    const saved = post({ id: 1, title: "Updated title" });
+    vi.mocked(fetch).mockResolvedValue(new Response(JSON.stringify(saved), { status: 200 }));
+
+    await queryClient
+      .getMutationCache()
+      .build(queryClient, getPostSaveMutationOptions("acme", 1))
+      .execute({ title: "Updated title", body: "Original body" });
+
+    expect(queryClient.getQueryData(getPostListQueryOptions("acme").queryKey)).toBeUndefined();
+  });
+});
