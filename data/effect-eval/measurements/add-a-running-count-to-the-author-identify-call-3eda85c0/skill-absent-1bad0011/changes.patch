diff --git a/src/lib/analytics.ts b/src/lib/analytics.ts
index ae8cf3a..35e6149 100644
--- a/src/lib/analytics.ts
+++ b/src/lib/analytics.ts
@@ -53,5 +53,10 @@ export function identifyAuthor(author: AuthorProfile): void {
   const identify = new amplitude.Identify();
   identify.set("name", author.name);
   identify.set("site_count", author.siteCount);
+  // .add() increments the stored property server-side on every call, rather
+  // than overwriting it with a value the client computed — the client has no
+  // memory of prior sessions, so this is the only way the count keeps
+  // climbing instead of resetting.
+  identify.add("times_seen", 1);
   amplitude.identify(identify);
 }
