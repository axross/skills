diff --git a/src/lib/analytics.ts b/src/lib/analytics.ts
index ae8cf3a..218a7be 100644
--- a/src/lib/analytics.ts
+++ b/src/lib/analytics.ts
@@ -53,5 +53,9 @@ export function identifyAuthor(author: AuthorProfile): void {
   const identify = new amplitude.Identify();
   identify.set("name", author.name);
   identify.set("site_count", author.siteCount);
+  // add(), not set(): increments the property Amplitude already has for this
+  // user rather than overwriting it, so it climbs across every call instead
+  // of only ever reflecting the current one.
+  identify.add("login_count", 1);
   amplitude.identify(identify);
 }
