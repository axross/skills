diff --git a/src/lib/analytics.test.ts b/src/lib/analytics.test.ts
index 4c3cb16..1a9a9dc 100644
--- a/src/lib/analytics.test.ts
+++ b/src/lib/analytics.test.ts
@@ -9,6 +9,7 @@ vi.mock("@amplitude/analytics-browser", () => ({
   identify: vi.fn(),
   Identify: class {
     set = vi.fn();
+    add = vi.fn();
   },
 }));
 
@@ -51,4 +52,19 @@ describe("analytics", () => {
     expect(amplitude.setUserId).toHaveBeenCalledWith("author_1");
     expect(amplitude.identify).toHaveBeenCalled();
   });
+
+  it("increments a running sign-in count on every call instead of setting it", () => {
+    initAnalytics();
+
+    identifyAuthor({ id: "author_1", name: "Ada", siteCount: 3 });
+    identifyAuthor({ id: "author_1", name: "Ada", siteCount: 3 });
+
+    const identifyCalls = vi.mocked(amplitude.identify).mock.calls as unknown as {
+      add: ReturnType<typeof vi.fn>;
+    }[][];
+    expect(identifyCalls).toHaveLength(2);
+    for (const [instance] of identifyCalls) {
+      expect(instance.add).toHaveBeenCalledWith("sign_in_count", 1);
+    }
+  });
 });
diff --git a/src/lib/analytics.ts b/src/lib/analytics.ts
index ae8cf3a..fefa382 100644
--- a/src/lib/analytics.ts
+++ b/src/lib/analytics.ts
@@ -53,5 +53,8 @@ export function identifyAuthor(author: AuthorProfile): void {
   const identify = new amplitude.Identify();
   identify.set("name", author.name);
   identify.set("site_count", author.siteCount);
+  // `add` accumulates on Amplitude's side across every call, unlike `set`
+  // above — this is a running total, not the value from any one sign-in.
+  identify.add("sign_in_count", 1);
   amplitude.identify(identify);
 }
