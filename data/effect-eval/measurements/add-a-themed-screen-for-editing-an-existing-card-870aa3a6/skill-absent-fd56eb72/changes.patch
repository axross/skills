+import {
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react-native";
+import type { PermissionResponse } from "expo-camera";
+
+import type { Deck } from "@/decks/deck";
+
+import { EditCardScreen } from "./edit-card-screen";
+
+const mockGetDeck = jest.fn();
+const mockUpdateCard = jest.fn();
+const mockBack = jest.fn();
+
+jest.mock("expo-router", () => ({
+  useLocalSearchParams: () => ({
+    deckId: "world-capitals",
+    cardId: "card-1",
+  }),
+  useRouter: () => ({ back: mockBack, push: jest.fn(), replace: jest.fn() }),
+}));
+
+// The guidance is explicit: never render a real CameraView in a test.
+jest.mock("expo-camera", () => ({
+  CameraView: () => null,
+  useCameraPermissions: () => [
+    {
+      status: "granted",
+      granted: true,
+      canAskAgain: true,
+      expires: "never",
+    } as PermissionResponse,
+    jest.fn(),
+  ],
+}));
+
+jest.mock("expo-linking", () => ({
+  openSettings: jest.fn(),
+}));
+
+jest.mock("@/decks/deck-repository", () => ({
+  getDeck: (...args: unknown[]) => mockGetDeck(...args),
+  updateCard: (...args: unknown[]) => mockUpdateCard(...args),
+}));
+
+jest.mock("@/analytics/analytics", () => ({
+  trackScreenView: jest.fn(),
+}));
+
+const DECK: Deck = {
+  id: "world-capitals",
+  name: "World Capitals",
+  cards: [
+    {
+      id: "card-1",
+      front: "Peru",
+      back: "Lima",
+      scheduling: {
+        dueAt: 0,
+        intervalDays: 0,
+        easeFactor: 2.5,
+        repetitions: 0,
+      },
+    },
+  ],
+};
+
+beforeEach(() => {
+  mockGetDeck.mockReset().mockResolvedValue(DECK);
+  mockUpdateCard.mockReset().mockResolvedValue(undefined);
+  mockBack.mockReset();
+});
+
+describe("EditCardScreen", () => {
+  it("prefills the front and back with the card's current values", async () => {
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toHaveProp("value", "Peru"),
+    );
+    expect(screen.getByTestId("edit-card-back")).toHaveProp("value", "Lima");
+  });
+
+  it("shows a visible error and does not navigate back when saving fails", async () => {
+    mockUpdateCard.mockRejectedValueOnce(new Error("boom"));
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toHaveProp("value", "Peru"),
+    );
+    await fireEvent.press(screen.getByTestId("submit-edit-card"));
+
+    await waitFor(() =>
+      expect(
+        screen.getByText("Couldn't save these changes. Try again."),
+      ).toBeOnTheScreen(),
+    );
+    expect(mockBack).not.toHaveBeenCalled();
+  });
+
+  it("saves the edited fields and navigates back", async () => {
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toHaveProp("value", "Peru"),
+    );
+    await fireEvent.changeText(
+      screen.getByTestId("edit-card-back"),
+      "Lima, Peru",
+    );
+    await fireEvent.press(screen.getByTestId("submit-edit-card"));
+
+    await waitFor(() => expect(mockBack).toHaveBeenCalledTimes(1));
+    expect(mockUpdateCard).toHaveBeenCalledWith("world-capitals", "card-1", {
+      front: "Peru",
+      back: "Lima, Peru",
+      photoUri: undefined,
+    });
+  });
+
+  it("shows a not-found state for a card id that doesn't exist in the deck", async () => {
+    mockGetDeck.mockResolvedValue({ ...DECK, cards: [] });
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByText("Card not found")).toBeOnTheScreen(),
+    );
+  });
+});
