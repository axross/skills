+/** Changes an existing card's front, back, and photo, and persists the result. */
+export async function updateCard(
+  deckId: string,
+  cardId: string,
+  input: { front: string; back: string; photoUri?: string },
+): Promise<Card> {
+  const decks = await readDecks();
+  const deck = decks.find((candidate) => candidate.id === deckId);
+  if (!deck) {
+    throw new Error(`No deck with id "${deckId}".`);
+  }
+
+  const card = deck.cards.find((candidate) => candidate.id === cardId);
+  if (!card) {
+    throw new Error(`No card with id "${cardId}" in deck "${deckId}".`);
+  }
+
+  card.front = input.front;
+  card.back = input.back;
+  card.photoUri = input.photoUri;
+  await writeDecks(decks);
+  return card;
+}
+
+/** Removes a card from its deck and persists the result. */
+export async function deleteCard(
+  deckId: string,
+  cardId: string,
+): Promise<void> {
+  const decks = await readDecks();
+  const deck = decks.find((candidate) => candidate.id === deckId);
+  if (!deck) {
+    throw new Error(`No deck with id "${deckId}".`);
+  }
+
+  const index = deck.cards.findIndex((candidate) => candidate.id === cardId);
+  if (index === -1) {
+    throw new Error(`No card with id "${cardId}" in deck "${deckId}".`);
+  }
+
+  deck.cards.splice(index, 1);
+  await writeDecks(decks);
+}
+
 /** Grades a card, advancing its scheduling state, and persists the result. */
 export async function gradeCard(
   deckId: string,
