+import {
+  act,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react-native";
+import type { PermissionResponse } from "expo-camera";
+import { Alert } from "react-native";
+
+import type { Deck } from "@/decks/deck";
+import { UNSTUDIED_STATE } from "@/scheduler/scheduler";
+
+import { EditCardScreen } from "./edit-card-screen";
+
+const mockGetDeck = jest.fn();
+const mockUpdateCard = jest.fn();
+const mockDeleteCard = jest.fn();
+const mockBack = jest.fn();
+// `jest-expo`'s preset already stubs `Alert.alert` as a jest mock — spying
+// on it rather than mocking the module keeps this in step with whatever
+// that preset does for every other native module.
+const mockAlert = jest.spyOn(Alert, "alert");
+
+jest.mock("expo-router", () => ({
+  useLocalSearchParams: () => ({
+    deckId: "world-capitals",
+    cardId: "card-peru",
+  }),
+  useRouter: () => ({ back: mockBack, push: jest.fn(), replace: jest.fn() }),
+}));
+
+// The guidance is explicit: never render a real CameraView in a test.
+jest.mock("expo-camera", () => ({
+  CameraView: () => null,
+  useCameraPermissions: () => [
+    {
+      status: "granted",
+      granted: true,
+      canAskAgain: true,
+      expires: "never",
+    } as PermissionResponse,
+    jest.fn(),
+  ],
+}));
+
+jest.mock("expo-linking", () => ({
+  openSettings: jest.fn(),
+}));
+
+jest.mock("@/decks/deck-repository", () => ({
+  getDeck: (...args: unknown[]) => mockGetDeck(...args),
+  updateCard: (...args: unknown[]) => mockUpdateCard(...args),
+  deleteCard: (...args: unknown[]) => mockDeleteCard(...args),
+}));
+
+jest.mock("@/analytics/analytics", () => ({
+  trackScreenView: jest.fn(),
+}));
+
+const DECK: Deck = {
+  id: "world-capitals",
+  name: "World Capitals",
+  cards: [
+    {
+      id: "card-peru",
+      front: "Peru",
+      back: "Lima",
+      scheduling: { ...UNSTUDIED_STATE },
+    },
+  ],
+};
+
+beforeEach(() => {
+  mockGetDeck.mockReset().mockResolvedValue(DECK);
+  mockUpdateCard.mockReset().mockResolvedValue(undefined);
+  mockDeleteCard.mockReset().mockResolvedValue(undefined);
+  mockBack.mockReset();
+  mockAlert.mockReset();
+});
+
+describe("EditCardScreen", () => {
+  it("prefills the card's current front and back", async () => {
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toBeOnTheScreen(),
+    );
+    expect(screen.getByTestId("edit-card-front").props.value).toBe("Peru");
+    expect(screen.getByTestId("edit-card-back").props.value).toBe("Lima");
+  });
+
+  it("shows a visible error and does not navigate back when saving fails", async () => {
+    mockUpdateCard.mockRejectedValueOnce(new Error("boom"));
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toBeOnTheScreen(),
+    );
+    await fireEvent.press(screen.getByTestId("submit-edit-card"));
+
+    await waitFor(() =>
+      expect(
+        screen.getByText("Couldn't save this card. Try again."),
+      ).toBeOnTheScreen(),
+    );
+    expect(mockBack).not.toHaveBeenCalled();
+  });
+
+  it("navigates back once the change saves", async () => {
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toBeOnTheScreen(),
+    );
+    await fireEvent.changeText(screen.getByTestId("edit-card-front"), "Peru?");
+    await fireEvent.press(screen.getByTestId("submit-edit-card"));
+
+    await waitFor(() => expect(mockBack).toHaveBeenCalledTimes(1));
+    expect(mockUpdateCard).toHaveBeenCalledWith("world-capitals", "card-peru", {
+      front: "Peru?",
+      back: "Lima",
+      photoUri: undefined,
+    });
+  });
+
+  it("asks for confirmation before deleting, and deletes only once confirmed", async () => {
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("delete-card")).toBeOnTheScreen(),
+    );
+    await fireEvent.press(screen.getByTestId("delete-card"));
+
+    expect(mockDeleteCard).not.toHaveBeenCalled();
+    expect(mockAlert).toHaveBeenCalledTimes(1);
+
+    const confirmButton = mockAlert.mock.calls[0]![2]![1]!;
+    await act(async () => {
+      await confirmButton.onPress!();
+    });
+
+    await waitFor(() => expect(mockBack).toHaveBeenCalledTimes(1));
+    expect(mockDeleteCard).toHaveBeenCalledWith("world-capitals", "card-peru");
+  });
+
+  it("shows a not-found state for a card id that no longer exists", async () => {
+    mockGetDeck.mockResolvedValue({ ...DECK, cards: [] });
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByText("Card not found")).toBeOnTheScreen(),
+    );
+  });
+});
