+import { describe, expect, it } from "@jest/globals";
+import {
+	findExactMatch,
+	findLanguageMatch,
+	normalizeLocale,
+	type Post,
+	resolveTranslation,
+} from "./resolve-translation";
+
+describe("normalizeLocale()", () => {
+	it("lowercases a locale tag", () => {
+		expect(normalizeLocale("EN-US")).toBe("en-us");
+	});
+
+	it("trims surrounding whitespace", () => {
+		expect(normalizeLocale(" en-US ")).toBe("en-us");
+	});
+});
+
+describe("findExactMatch()", () => {
+	const post: Post = {
+		slug: "hello",
+		defaultLocale: "en-US",
+		translations: [
+			{ locale: "en-US", title: "Hello", body: "..." },
+			{ locale: "ja", title: "こんにちは", body: "..." },
+		],
+	};
+
+	it("returns the translation whose locale matches exactly", () => {
+		expect(findExactMatch(post, "ja")?.title).toBe("こんにちは");
+	});
+
+	it("matches regardless of the locale tag's case", () => {
+		expect(findExactMatch(post, "EN-us")?.title).toBe("Hello");
+	});
+
+	it("does not match a translation with the same language but a different region", () => {
+		expect(findExactMatch(post, "en-GB")).toBeNull();
+	});
+
+	it("returns null when no translation matches", () => {
+		expect(findExactMatch(post, "fr")).toBeNull();
+	});
+});
+
+describe("findLanguageMatch()", () => {
+	it("reaches a region-tagged translation from a bare language subtag", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [{ locale: "ja-JP", title: "こんにちは", body: "..." }],
+		};
+
+		expect(findLanguageMatch(post, "ja")?.title).toBe("こんにちは");
+	});
+
+	it("reaches a bare-language translation from a region-tagged locale", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [{ locale: "ja", title: "こんにちは", body: "..." }],
+		};
+
+		expect(findLanguageMatch(post, "ja-JP")?.title).toBe("こんにちは");
+	});
+
+	it("returns null when no translation shares the language", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [{ locale: "en-US", title: "Hello", body: "..." }],
+		};
+
+		expect(findLanguageMatch(post, "ja")).toBeNull();
+	});
+});
+
+describe("resolveTranslation()", () => {
+	it("prefers an exact match over a language-only match", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [
+				{ locale: "en", title: "English (generic)", body: "..." },
+				{ locale: "en-US", title: "English (US)", body: "..." },
+			],
+		};
+
+		expect(resolveTranslation(post, ["en-US"])?.title).toBe("English (US)");
+	});
+
+	it("honors accepted-locale preference order for exact matches", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [
+				{ locale: "fr", title: "French", body: "..." },
+				{ locale: "ja", title: "Japanese", body: "..." },
+			],
+		};
+
+		expect(resolveTranslation(post, ["ja", "fr"])?.title).toBe("Japanese");
+	});
+
+	it("falls back to a language-only match when no accepted locale matches exactly", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [{ locale: "ja", title: "Japanese", body: "..." }],
+		};
+
+		expect(resolveTranslation(post, ["ja-JP"])?.title).toBe("Japanese");
+	});
+
+	it("checks every accepted locale for an exact match before trying any language-only match", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [
+				{ locale: "fr", title: "French (generic)", body: "..." },
+				{ locale: "fr-CA", title: "French (Canada)", body: "..." },
+			],
+		};
+
+		// "fr-CA" only exact-matches the second accepted locale, but that exact
+		// match must still win over "fr" language-matching the first.
+		expect(resolveTranslation(post, ["fr-CA", "fr"])?.title).toBe(
+			"French (Canada)",
+		);
+	});
+
+	it("falls back to the post's default locale when nothing accepted matches", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [
+				{ locale: "en-US", title: "English", body: "..." },
+				{ locale: "ja", title: "Japanese", body: "..." },
+			],
+		};
+
+		expect(resolveTranslation(post, ["fr", "de"])?.title).toBe("English");
+	});
+
+	it("returns null when the post has no translations at all", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [],
+		};
+
+		expect(resolveTranslation(post, ["en-US"])).toBeNull();
+	});
+
+	it("returns null when no accepted locale matches and the default locale has no translation", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [{ locale: "ja", title: "Japanese", body: "..." }],
+		};
+
+		expect(resolveTranslation(post, ["fr"])).toBeNull();
+	});
+
+	it("returns null when acceptedLocales is empty and the default locale has no translation", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en-US",
+			translations: [{ locale: "ja", title: "Japanese", body: "..." }],
+		};
+
+		expect(resolveTranslation(post, [])).toBeNull();
+	});
+});
