+  let address = ip;
+  const ipv4Tail = address.match(/(\d+\.\d+\.\d+\.\d+)$/);
+  if (ipv4Tail) {
+    const [a, b, c, d] = ipv4Tail[1].split(".").map(Number);
+    const high = ((a << 8) | b).toString(16);
+    const low = ((c << 8) | d).toString(16);
+    address = `${address.slice(0, -ipv4Tail[1].length)}${high}:${low}`;
+  }
