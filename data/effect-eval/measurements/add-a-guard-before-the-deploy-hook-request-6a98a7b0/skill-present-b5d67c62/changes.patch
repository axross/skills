+  let headParts: string[];
+  let tailParts: string[];
+  if (address.includes("::")) {
+    const [head, tail] = address.split("::");
+    headParts = head ? head.split(":").filter(Boolean) : [];
+    tailParts = tail ? tail.split(":").filter(Boolean) : [];
+  } else {
+    headParts = address.split(":").filter(Boolean);
+    tailParts = [];
+  }
