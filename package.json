{
  "name": "skills",
  "version": "0.0.0",
  "private": true,
  "description": "A curated, reusable library of Claude Code agent skills.",
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yaml,yml}\"",
    "lint": "markdownlint-cli2 \"**/*.md\"",
    "links": "./.claude/skills/agent-skill-authoring/scripts/check-links.sh",
    "skill-structure": "node ./.claude/skills/agent-skill-authoring/scripts/check-skill.mjs --require-claude-code-fields skills .claude/skills",
    "installed-copies": "node ./scripts/check-installed-copies.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm run links && npm run skill-structure && npm run installed-copies && npm test"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.15.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": "26"
  }
}
