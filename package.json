{
  "name": "skills",
  "version": "0.0.0",
  "private": true,
  "description": "An opinionated library of agent skills.",
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yaml,yml}\"",
    "lint": "markdownlint-cli2 \"**/*.md\"",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.15.0",
    "prettier": "^3.4.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "26"
  }
}
