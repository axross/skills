# Copy this to .env.local (Vite) and/or .env (the API) and fill in what you have.
# Nothing here is required to run the app locally — every value below has a
# safe default that just disables the feature it configures.

# --- Frontend (Vite; must be prefixed VITE_ to reach the browser bundle) ---

# Amplitude project API key. Analytics stays disabled without one — see
# src/lib/analytics.ts.
VITE_AMPLITUDE_API_KEY=

# Sentry DSN for the browser SDK. Error reporting stays disabled without one —
# see src/instrument.ts.
VITE_SENTRY_DSN=

# --- Build-time only (never reaches the browser bundle) ---

# Sentry source-map upload. The build succeeds without these; it just doesn't
# upload anything — see vite.config.ts and docs/deploy-hooks.md's neighbour,
# the Sentry section of README.md.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- API (server/) ---

# Where the SQLite file lives. Defaults to server/db/data/blog-cms.db.
DATABASE_PATH=

# Port the Hono API listens on. Defaults to 8787.
PORT=

# debug | info | warn | error. Defaults to info — see shared/logger.ts.
LOG_LEVEL=
