+import { render } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { PublishToast } from "./PublishToast";
+
+describe("PublishToast", () => {
+  it("shows its message", () => {
+    const { getByText } = render(<PublishToast tone="success" message="Published." />);
+
+    expect(getByText("Published.")).toBeInTheDocument();
+  });
+
+  it("announces itself as a status region for assistive tech", () => {
+    const { getByRole } = render(<PublishToast tone="success" message="Published." />);
+
+    expect(getByRole("status")).toBeInTheDocument();
+  });
+
+  it("carries a distinct class for the error tone", () => {
+    const success = render(<PublishToast tone="success" message="Published." />);
+    const error = render(<PublishToast tone="error" message="Publishing failed." />);
+
+    expect(error.container.firstElementChild?.className).not.toBe(
+      success.container.firstElementChild?.className,
+    );
+  });
+});
