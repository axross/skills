@@ -0,0 +1,15 @@
+/**
+ * Rendered whenever `notFound()` is called anywhere under the `(site)` route
+ * group — currently only the post detail page, for a slug with no post or no
+ * renderable translation. Kept here rather than under `posts/[slug]/` so any
+ * future not-found case in this route group gets the same page.
+ */
+export default function NotFound() {
+	return (
+		<section aria-label="not found">
+			<h1>ページが見つかりません</h1>
+			<p>お探しの投稿は存在しないか、削除された可能性があります。</p>
+			<a href="/">トップページに戻る</a>
+		</section>
+	);
+}
