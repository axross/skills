+++ b/app/(site)/posts/[slug]/not-found.tsx
@@ -0,0 +1,12 @@
+/** Shown when a post slug doesn't match anything in the catalog. */
+export default function PostNotFound() {
+	return (
+		<section aria-label="not found">
+			<h1>No such post</h1>
+			<p>
+				There's no post at this address. It may have moved, or never existed.
+			</p>
+			<a href="/">Back to the posts</a>
+		</section>
+	);
+}
