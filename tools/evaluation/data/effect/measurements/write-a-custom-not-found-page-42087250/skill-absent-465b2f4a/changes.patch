+test("the not-found page speaks in the blog's own voice, not the framework default", async ({
+	page,
+}) => {
+	await page.goto("/posts/does-not-exist");
+
+	await expect(
+		page.getByRole("heading", { name: "No such post" }),
+	).toBeVisible();
+	await expect(
+		page.getByRole("link", { name: "Back to the posts" }),
+	).toHaveAttribute("href", "/");
+});
