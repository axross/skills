+/** Rendered when a URL doesn't match a page or `notFound()` is called from one, e.g. an unknown post slug. */
+export default function NotFound() {
+	return (
+		<section aria-label="not found">
+			<h1>Nothing here</h1>
+			<p>
+				There's no post at this address — it may have moved, or never existed.
+				Try the <a href="/">home page</a> instead.
+			</p>
+		</section>
+	);
+}
