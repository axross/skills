+/**
+ * The translation this request should render for `post`, resolved from the
+ * request's `Accept-Language` header. Shared between {@link generateMetadata}
+ * and the page itself so both agree on the same translation.
+ */
+async function translationForRequest(
+	post: Post,
+): Promise<PostTranslation | null> {
+	const requestHeaders = await headers();
+	return resolveTranslation(
+		post,
+		acceptedLocales(requestHeaders.get("accept-language")),
+	);
+}
+
+export async function generateMetadata({
+	params,
+}: PostPageProps): Promise<Metadata> {
+	const { slug } = await params;
+	const post = findPostBySlug(slug);
+	if (!post) return {};
+
+	const translation = await translationForRequest(post);
+	if (!translation) return {};
+
+	return { title: translation.title };
+}
