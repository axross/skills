@@ -0,0 +1,28 @@
+import { describe, expect, it } from "vitest";
+import type { Post } from "../types";
+import { summarizePostCounts } from "./PostListPage";
+
+function post(status: Post["status"]): Post {
+  return {
+    id: 1,
+    siteId: 1,
+    title: "Untitled",
+    slug: "untitled",
+    body: "",
+    status,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+  };
+}
+
+describe("summarizePostCounts", () => {
+  it("counts an empty list as zero of everything", () => {
+    expect(summarizePostCounts([])).toEqual({ total: 0, published: 0, draft: 0 });
+  });
+
+  it("splits posts into published and draft", () => {
+    const posts = [post("published"), post("draft"), post("published"), post("draft")];
+
+    expect(summarizePostCounts(posts)).toEqual({ total: 4, published: 2, draft: 2 });
+  });
+});
