+/** Counts a site's posts by status — the post list already carries everything this needs. */
+export function summarizePostCounts(posts: readonly Post[]): PostCounts {
+  const published = posts.filter((post) => post.status === "published").length;
+  return { total: posts.length, published, draft: posts.length - published };
+}
