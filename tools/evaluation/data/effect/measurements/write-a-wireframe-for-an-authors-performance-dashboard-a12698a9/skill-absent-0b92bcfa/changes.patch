+import { render } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import type { Post } from "../../types";
+import { PostStats } from "./PostStats";
+
+function post(status: Post["status"]): Post {
+  return {
+    id: Math.random(),
+    siteId: 1,
+    title: "A post",
+    slug: "a-post",
+    body: "Body",
+    status,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+  };
+}
+
+describe("PostStats", () => {
+  it("counts published and draft posts separately", () => {
+    const { getByText } = render(
+      <PostStats posts={[post("published"), post("published"), post("draft")]} />,
+    );
+
+    expect(getByText("Published").nextElementSibling).toHaveTextContent("2");
+    expect(getByText("Drafts").nextElementSibling).toHaveTextContent("1");
+  });
+
+  it("reports zero for a status with no posts", () => {
+    const { getByText } = render(<PostStats posts={[post("published")]} />);
+
+    expect(getByText("Drafts").nextElementSibling).toHaveTextContent("0");
+  });
+});
