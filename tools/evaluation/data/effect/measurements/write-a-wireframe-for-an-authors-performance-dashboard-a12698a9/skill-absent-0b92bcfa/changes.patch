diff --git a/src/components/PostStats/PostStats.tsx b/src/components/PostStats/PostStats.tsx
new file mode 100644
index 0000000..0e8846d
--- /dev/null
+++ b/src/components/PostStats/PostStats.tsx
@@ -0,0 +1,25 @@
+import type { Post } from "../../types";
+import css from "./PostStats.module.css";
+
+interface PostStatsProps {
+  readonly posts: readonly Post[];
+}
+
+/** A per-site "how are my posts doing" summary: published vs. draft counts. */
+export function PostStats({ posts }: PostStatsProps) {
+  const published = posts.filter((post) => post.status === "published").length;
+  const draft = posts.length - published;
+
+  return (
+    <dl className={css.stats} aria-label="Post stats">
+      <div className={css.stat}>
+        <dt className={css.label}>Published</dt>
+        <dd className={css.value}>{published}</dd>
+      </div>
+      <div className={css.stat}>
+        <dt className={css.label}>Drafts</dt>
+        <dd className={css.value}>{draft}</dd>
+      </div>
+    </dl>
+  );
+}
