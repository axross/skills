@@ -0,0 +1,39 @@
+import { describe, expect, it } from "@jest/globals";
+import { LocaleTag } from "./locale-tag";
+
+describe("LocaleTag", () => {
+	it("accepts a bare language subtag", () => {
+		expect(LocaleTag.safeParse("en").success).toBe(true);
+		expect(LocaleTag.safeParse("ja").success).toBe(true);
+	});
+
+	it("accepts a language plus region subtag", () => {
+		expect(LocaleTag.safeParse("en-US").success).toBe(true);
+		expect(LocaleTag.safeParse("ja-JP").success).toBe(true);
+	});
+
+	it("accepts a 3-letter language subtag", () => {
+		expect(LocaleTag.safeParse("haw").success).toBe(true);
+	});
+
+	it("rejects a region written in the wrong case", () => {
+		expect(LocaleTag.safeParse("en-us").success).toBe(false);
+		expect(LocaleTag.safeParse("EN-US").success).toBe(false);
+	});
+
+	it("rejects an underscore separator", () => {
+		expect(LocaleTag.safeParse("en_US").success).toBe(false);
+	});
+
+	it("rejects a script subtag", () => {
+		expect(LocaleTag.safeParse("zh-Hans-CN").success).toBe(false);
+	});
+
+	it("rejects a 3-digit UN M49 region", () => {
+		expect(LocaleTag.safeParse("es-419").success).toBe(false);
+	});
+
+	it("rejects an empty string", () => {
+		expect(LocaleTag.safeParse("").success).toBe(false);
+	});
+});
