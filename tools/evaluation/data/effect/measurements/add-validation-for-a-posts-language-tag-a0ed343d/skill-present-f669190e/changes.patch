+import { describe, expect, it } from "@jest/globals";
+import { LocaleTag } from "@/shared/locale-tag";
+import { POSTS } from "./posts-data";
+
+describe("POSTS", () => {
+	it("every defaultLocale matches LocaleTag", () => {
+		for (const post of POSTS) {
+			expect(LocaleTag.safeParse(post.defaultLocale).success).toBe(true);
+		}
+	});
+
+	it("every translation's locale matches LocaleTag", () => {
+		for (const post of POSTS) {
+			for (const translation of post.translations) {
+				expect(LocaleTag.safeParse(translation.locale).success).toBe(true);
+			}
+		}
+	});
+});
