--- /dev/null
+++ b/shared/locale-tag.ts
@@ -0,0 +1,18 @@
+import { z } from "zod";
+
+/**
+ * Shape of a locale tag as this project writes them: a 2–3 letter lowercase
+ * language subtag, optionally followed by a hyphen and a 2-letter uppercase
+ * region subtag — `"ja"`, `"ja-JP"`, `"en-US"`. This does not cover the full
+ * range BCP 47 allows (script subtags, numeric UN M49 regions, variants); it
+ * covers the shapes a post's `translations` and `defaultLocale` actually use,
+ * the same way {@link import("./blog-post-slug").PostSlug} covers the shapes
+ * a slug actually uses rather than every string BCP 47 or a URL permits.
+ */
+export const LocaleTag = z.string().regex(/^[a-z]{2,3}(?:-[A-Z]{2})?$/);
+
+export type LocaleTag = z.infer<typeof LocaleTag>;
+
+/** Message shown next to a locale field that failed {@link LocaleTag}. */
+export const LOCALE_TAG_VALIDATION_MESSAGE =
+	"Use a language subtag, optionally followed by a hyphen and an uppercase region (e.g. en, en-US, ja-JP).";
