index 0000000..02e27f9
--- /dev/null
+++ b/shared/locale-tag.ts
@@ -0,0 +1,19 @@
+import { z } from "zod";
+
+/**
+ * Shape of a locale tag, as used for both {@link PostTranslation.locale} and
+ * {@link Post.defaultLocale}: a lowercase two- or three-letter language
+ * subtag, optionally followed by a hyphen and an uppercase two-letter region
+ * subtag — `"ja"`, `"en"`, `"ja-JP"`, `"en-US"`. This is the one shape every
+ * locale tag in the project is written in; it exists so a new translation
+ * can't introduce a third one (`"en_US"`, `"EN-us"`, `"en-USA"`, a script
+ * subtag, ...). It is narrower than full BCP 47 on purpose, the same way
+ * {@link PostSlug} is narrower than a general URL path segment.
+ */
+export const LocaleTag = z.string().regex(/^[a-z]{2,3}(?:-[A-Z]{2})?$/);
+
+export type LocaleTag = z.infer<typeof LocaleTag>;
+
+/** Message shown next to a locale field that failed {@link LocaleTag}. */
+export const LOCALE_TAG_VALIDATION_MESSAGE =
+	"Use a lowercase language subtag, optionally followed by a hyphen and an uppercase region (e.g. ja, en-US).";
