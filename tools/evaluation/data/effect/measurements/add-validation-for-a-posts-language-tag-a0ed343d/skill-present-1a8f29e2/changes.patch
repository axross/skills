+import { describe, expect, it } from "@jest/globals";
+import { LocaleTag } from "@/shared/locale-tag";
+import { POSTS } from "./posts-data";
+
+// Every locale tag in the checked-in catalog is authored by hand, with
+// nothing else parsing it before it reaches a page. This is what actually
+// stops a future post's tag from drifting into a third shape, rather than
+// just documenting the one two of the existing posts happen to follow.
+describe("POSTS locale tags", () => {
+	for (const post of POSTS) {
+		it(`${post.slug}: defaultLocale "${post.defaultLocale}" is LocaleTag-shaped`, () => {
+			expect(LocaleTag.safeParse(post.defaultLocale).success).toBe(true);
+		});
+
+		for (const translation of post.translations) {
+			it(`${post.slug}: translation locale "${translation.locale}" is LocaleTag-shaped`, () => {
+				expect(LocaleTag.safeParse(translation.locale).success).toBe(true);
+			});
+		}
+	}
+});
