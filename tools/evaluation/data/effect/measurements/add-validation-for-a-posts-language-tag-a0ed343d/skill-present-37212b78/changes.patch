@@ -0,0 +1,31 @@
+import { describe, expect, it } from "@jest/globals";
+import { PostLocale } from "./blog-post-locale";
+
+describe("PostLocale", () => {
+	it("accepts a language-only tag", () => {
+		expect(PostLocale.safeParse("ja").success).toBe(true);
+		expect(PostLocale.safeParse("en").success).toBe(true);
+	});
+
+	it("accepts a language-and-region tag", () => {
+		expect(PostLocale.safeParse("ja-JP").success).toBe(true);
+		expect(PostLocale.safeParse("en-US").success).toBe(true);
+	});
+
+	it("rejects an underscore separator", () => {
+		expect(PostLocale.safeParse("en_US").success).toBe(false);
+	});
+
+	it("rejects the wrong casing", () => {
+		expect(PostLocale.safeParse("EN-US").success).toBe(false);
+		expect(PostLocale.safeParse("en-us").success).toBe(false);
+	});
+
+	it("rejects a tag with a script or variant subtag", () => {
+		expect(PostLocale.safeParse("zh-Hans-CN").success).toBe(false);
+	});
+
+	it("rejects an empty tag", () => {
+		expect(PostLocale.safeParse("").success).toBe(false);
+	});
+});
diff --git a/shared/blog-post-locale.ts b/shared/blog-post-locale.ts
new file mode 100644
index 0000000..ffaab92
--- /dev/null
+++ b/shared/blog-post-locale.ts
@@ -0,0 +1,25 @@
+import { z } from "zod";
+
+/**
+ * Shape of a post locale tag: a 2- or 3-letter lowercase language subtag,
+ * optionally followed by a hyphen and a 2-letter uppercase region subtag —
+ * e.g. `"ja"`, `"ja-JP"`, `"en-US"`. This is the canonical casing BCP 47
+ * itself recommends (language lowercase, region uppercase), not the full
+ * BCP 47 grammar; the project's own tags fit this narrower shape and are
+ * validated against it so a new one can't drift to a third shape (an
+ * underscore separator, wrong casing, a script or variant subtag, ...).
+ *
+ * `shared/resolve-translation.ts` normalizes case before comparing two tags,
+ * so matching a translation to a reader's `Accept-Language` header does not
+ * depend on this canonical shape — this schema only guards what gets stored.
+ */
+export const PostLocale = z.stringFormat(
+	"post-locale",
+	/^[a-z]{2,3}(-[A-Z]{2})?$/,
+);
+
+export type PostLocale = z.infer<typeof PostLocale>;
+
+/** Message shown next to a locale field that failed {@link PostLocale}. */
+export const LOCALE_VALIDATION_MESSAGE =
+	"Use a language code, optionally with a region (e.g. ja or en-US).";
