+import { describe, expect, it } from "@jest/globals";
+import { PostLocale } from "@/shared/blog-post-locale";
+import { POSTS } from "./posts-data";
+
+describe("POSTS locale tags", () => {
+	it("every post's defaultLocale matches the canonical shape", () => {
+		for (const post of POSTS) {
+			expect(PostLocale.safeParse(post.defaultLocale).success).toBe(true);
+		}
+	});
+
+	it("every translation's locale matches the canonical shape", () => {
+		for (const post of POSTS) {
+			for (const translation of post.translations) {
+				expect(PostLocale.safeParse(translation.locale).success).toBe(true);
+			}
+		}
+	});
+});
