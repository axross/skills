+import {
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react-native";
+import type { PermissionResponse } from "expo-camera";
+
+import { UNSTUDIED_STATE } from "@/scheduler/scheduler";
+import type { Deck } from "@/decks/deck";
+
+import { EditCardScreen } from "./edit-card-screen";
+
+const mockGetDeck = jest.fn();
+const mockUpdateCard = jest.fn();
+const mockBack = jest.fn();
+let mockSearchParams: { deckId?: string; cardId?: string } = {
+  deckId: "world-capitals",
+  cardId: "card-peru",
+};
+
+jest.mock("expo-router", () => ({
+  useLocalSearchParams: () => mockSearchParams,
+  useRouter: () => ({ back: mockBack, push: jest.fn(), replace: jest.fn() }),
+}));
+
+// The guidance is explicit: never render a real CameraView in a test.
+jest.mock("expo-camera", () => ({
+  CameraView: () => null,
+  useCameraPermissions: () => [
+    {
+      status: "granted",
+      granted: true,
+      canAskAgain: true,
+      expires: "never",
+    } as PermissionResponse,
+    jest.fn(),
+  ],
+}));
+
+jest.mock("expo-linking", () => ({
+  openSettings: jest.fn(),
+}));
+
+jest.mock("@/decks/deck-repository", () => ({
+  getDeck: (...args: unknown[]) => mockGetDeck(...args),
+  updateCard: (...args: unknown[]) => mockUpdateCard(...args),
+}));
+
+jest.mock("@/analytics/analytics", () => ({
+  trackScreenView: jest.fn(),
+}));
+
+const DECK: Deck = {
+  id: "world-capitals",
+  name: "World Capitals",
+  cards: [
+    {
+      id: "card-peru",
+      front: "Peru",
+      back: "Lima",
+      scheduling: { ...UNSTUDIED_STATE },
+    },
+  ],
+};
+
+beforeEach(() => {
+  mockSearchParams = { deckId: "world-capitals", cardId: "card-peru" };
+  mockGetDeck.mockReset().mockResolvedValue(DECK);
+  mockUpdateCard.mockReset().mockResolvedValue(undefined);
+  mockBack.mockReset();
+});
+
+describe("EditCardScreen", () => {
+  it("shows the card's current front and back", async () => {
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toBeOnTheScreen(),
+    );
+    expect(screen.getByTestId("edit-card-front").props.value).toBe("Peru");
+    expect(screen.getByTestId("edit-card-back").props.value).toBe("Lima");
+  });
+
+  it("saves the edited front and back and navigates back", async () => {
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toBeOnTheScreen(),
+    );
+    await fireEvent.changeText(
+      screen.getByTestId("edit-card-front"),
+      "Peru (Republic of)",
+    );
+    await fireEvent.press(screen.getByTestId("submit-edit-card"));
+
+    await waitFor(() =>
+      expect(mockUpdateCard).toHaveBeenCalledWith(
+        "world-capitals",
+        "card-peru",
+        {
+          front: "Peru (Republic of)",
+          back: "Lima",
+          photoUri: undefined,
+        },
+      ),
+    );
+    expect(mockBack).toHaveBeenCalledTimes(1);
+  });
+
+  it("shows a visible error and does not navigate back when saving fails", async () => {
+    mockUpdateCard.mockRejectedValueOnce(new Error("boom"));
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("edit-card-front")).toBeOnTheScreen(),
+    );
+    await fireEvent.press(screen.getByTestId("submit-edit-card"));
+
+    await waitFor(() =>
+      expect(
+        screen.getByText("Couldn't save this card. Try again."),
+      ).toBeOnTheScreen(),
+    );
+    expect(mockBack).not.toHaveBeenCalled();
+  });
+
+  it("shows a not-found state for a card id that isn't in the deck", async () => {
+    mockSearchParams = { deckId: "world-capitals", cardId: "does-not-exist" };
+    await render(<EditCardScreen />);
+
+    await waitFor(() =>
+      expect(screen.getByText("Card not found")).toBeOnTheScreen(),
+    );
+  });
+});
