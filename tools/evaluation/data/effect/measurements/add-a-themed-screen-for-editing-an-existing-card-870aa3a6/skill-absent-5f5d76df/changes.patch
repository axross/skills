+/**
+ * A route's `cardId` parameter is untrusted input the same way `deckId` is —
+ * see `normalizeDeckId` for why this trims and rejects anything but a
+ * non-empty string before a lookup trusts it.
+ */
+export function normalizeCardId(
+  raw: string | string[] | undefined,
+): string | null {
+  if (typeof raw !== "string") {
+    return null;
+  }
+
+  const trimmed = raw.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
