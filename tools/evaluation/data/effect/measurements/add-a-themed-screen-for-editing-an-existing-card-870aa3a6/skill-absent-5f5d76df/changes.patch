+import { normalizeCardId } from "./card-id";
+
+describe("normalizeCardId", () => {
+  it("accepts a well-formed id", () => {
+    expect(normalizeCardId("card-1")).toBe("card-1");
+  });
+
+  it("trims surrounding whitespace", () => {
+    expect(normalizeCardId("  card-1  ")).toBe("card-1");
+  });
+
+  it.each([
+    ["undefined", undefined],
+    ["an empty string", ""],
+    ["only whitespace", "   "],
+    ["a repeated-segment array", ["card-1", "extra"]],
+  ])("rejects %s", (_label, raw) => {
+    expect(normalizeCardId(raw)).toBeNull();
+  });
+});
