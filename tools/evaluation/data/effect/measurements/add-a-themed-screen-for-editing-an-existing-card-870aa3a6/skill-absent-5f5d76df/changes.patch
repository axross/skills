+import { useEffect, useState } from "react";
+import { useCameraPermissions } from "expo-camera";
+import * as Linking from "expo-linking";
+import { useLocalSearchParams, useRouter } from "expo-router";
+import { Text } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+
+import { normalizeDeckId } from "@/decks/deck-id";
+import { DeckLoadError } from "@/decks/deck-load-error";
+import { DeckNotFound } from "@/decks/deck-not-found";
+import { updateCard } from "@/decks/deck-repository";
+import { useDeckByRouteParam } from "@/decks/use-deck-by-route-param";
+import { trackScreenView } from "@/analytics/analytics";
+import { ActionButton } from "@/ui/action-button";
+import { LoadingScreen } from "@/ui/loading-screen";
+import { Screen } from "@/ui/screen";
+import { ScreenHeader } from "@/ui/screen-header";
+import { TextField } from "@/ui/text-field";
+
+import { normalizeCardId } from "./card-id";
+import { CardNotFound } from "./card-not-found";
+import { PhotoCapture } from "./photo-capture";
+
+export function EditCardScreen() {
+  const params = useLocalSearchParams<{ deckId?: string; cardId?: string }>();
+  const router = useRouter();
+  const deckId = normalizeDeckId(params.deckId);
+  const cardId = normalizeCardId(params.cardId);
+
+  const { deck, status } = useDeckByRouteParam(deckId);
+  const [front, setFront] = useState("");
+  const [back, setBack] = useState("");
+  const [photoUri, setPhotoUri] = useState<string | undefined>(undefined);
+  const [error, setError] = useState<string | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+  const [permission, requestPermission] = useCameraPermissions();
+
+  useEffect(() => {
+    trackScreenView("Edit Card");
+  }, []);
+
+  const card = deck?.cards.find((candidate) => candidate.id === cardId);
+
+  // The fields above start empty and are filled in once the card loads.
+  // Adjusted here, during render, rather than in an effect, so the fields
+  // never briefly render empty then flash to the card's values a beat later;
+  // `prefilledCardId` guards it to once per card so a learner's own edits
+  // are never mistaken for the card's values arriving a second time.
+  const [prefilledCardId, setPrefilledCardId] = useState<string | null>(null);
+  if (card && prefilledCardId !== card.id) {
+    setPrefilledCardId(card.id);
+    setFront(card.front);
+    setBack(card.back);
+    setPhotoUri(card.photoUri);
+  }
+
+  if (deckId === null || cardId === null || status === "not-found") {
+    return <DeckNotFound />;
+  }
+
+  if (status === "error") {
+    return <DeckLoadError />;
+  }
+
+  if (!deck) {
+    return <LoadingScreen />;
+  }
+
+  if (!card) {
+    return <CardNotFound deckId={deck.id} />;
+  }
+
+  const currentDeckId = deck.id;
+  const currentCardId = card.id;
+
+  async function handleSubmit() {
+    if (!front.trim() || !back.trim()) {
+      setError("Enter both the front and the back of the card.");
+      return;
+    }
+
+    setError(null);
+    setSubmitting(true);
+    try {
+      await updateCard(currentDeckId, currentCardId, {
+        front: front.trim(),
+        back: back.trim(),
+        photoUri,
+      });
+      router.back();
+    } catch {
+      setError("Couldn't save this card. Try again.");
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  return (
+    <Screen scrollable>
+      <ScreenHeader title="Edit card" onBack={() => router.back()} />
+      <TextField
+        label="Front"
+        value={front}
+        onChangeText={setFront}
+        testID="edit-card-front"
+      />
+      <TextField
+        label="Back"
+        value={back}
+        onChangeText={setBack}
+        testID="edit-card-back"
+      />
+      <PhotoCapture
+        permission={permission}
+        photoUri={photoUri}
+        onRequestPermission={() => void requestPermission()}
+        onOpenSettings={() => void Linking.openSettings()}
+        onCapture={setPhotoUri}
+        onClear={() => setPhotoUri(undefined)}
+      />
+      {error ? <Text style={styles.error}>{error}</Text> : null}
+      <ActionButton
+        label={submitting ? "Saving…" : "Save changes"}
+        onPress={handleSubmit}
+        testID="submit-edit-card"
+      />
+    </Screen>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  error: {
+    ...theme.typography.caption,
+    color: theme.colors.negative,
+  },
+}));
