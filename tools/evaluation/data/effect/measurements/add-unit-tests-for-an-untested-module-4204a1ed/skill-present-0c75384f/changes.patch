+++ b/shared/resolve-translation.spec.ts
@@ -0,0 +1,170 @@
+import { describe, expect, it } from "@jest/globals";
+import {
+	findExactMatch,
+	findLanguageMatch,
+	normalizeLocale,
+	type Post,
+	resolveTranslation,
+} from "./resolve-translation";
+
+describe("normalizeLocale()", () => {
+	it("lowercases a locale tag", () => {
+		expect(normalizeLocale("EN-US")).toBe("en-us");
+	});
+
+	it("trims surrounding whitespace", () => {
+		expect(normalizeLocale("  en-US  ")).toBe("en-us");
+	});
+});
+
+describe("findExactMatch()", () => {
+	it("returns the translation whose locale matches exactly", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [
+				{ locale: "en-US", title: "Hello", body: "..." },
+				{ locale: "ja", title: "こんにちは", body: "..." },
+			],
+		};
+
+		expect(findExactMatch(post, "en-US")?.title).toBe("Hello");
+	});
+
+	it("matches regardless of case", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "en-US", title: "Hello", body: "..." }],
+		};
+
+		expect(findExactMatch(post, "EN-us")?.title).toBe("Hello");
+	});
+
+	it("returns null when only a broader-language translation exists", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "en", title: "Hello", body: "..." }],
+		};
+
+		expect(findExactMatch(post, "en-US")).toBeNull();
+	});
+
+	it("returns null when the post has no translations", () => {
+		const post: Post = { slug: "hello", defaultLocale: "en", translations: [] };
+
+		expect(findExactMatch(post, "en")).toBeNull();
+	});
+});
+
+describe("findLanguageMatch()", () => {
+	it("matches a region-specific request to a plain-language translation", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "ja", title: "こんにちは", body: "..." }],
+		};
+
+		expect(findLanguageMatch(post, "ja-JP")?.title).toBe("こんにちは");
+	});
+
+	it("matches a plain-language request to a region-specific translation", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "ja-JP", title: "こんにちは", body: "..." }],
+		};
+
+		expect(findLanguageMatch(post, "ja")?.title).toBe("こんにちは");
+	});
+
+	it("returns null when no translation shares the language subtag", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "ja", title: "こんにちは", body: "..." }],
+		};
+
+		expect(findLanguageMatch(post, "en")).toBeNull();
+	});
+});
+
+describe("resolveTranslation()", () => {
+	it("prefers an exact match for the most preferred accepted locale", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [
+				{ locale: "en-US", title: "Hello", body: "..." },
+				{ locale: "fr", title: "Bonjour", body: "..." },
+			],
+		};
+
+		expect(resolveTranslation(post, ["fr", "en-US"])?.title).toBe("Bonjour");
+	});
+
+	it("checks every accepted locale for an exact match before trying language matches", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [
+				{ locale: "fr-CA", title: "Bonjour (CA)", body: "..." },
+				{ locale: "en-US", title: "Hello", body: "..." },
+			],
+		};
+
+		// "fr" has only a language match (fr-CA), while "en-US" has an exact
+		// match; the exact match for the second-choice locale wins.
+		expect(resolveTranslation(post, ["fr", "en-US"])?.title).toBe("Hello");
+	});
+
+	it("falls back to a language match when no accepted locale has an exact match", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "ja-JP", title: "こんにちは", body: "..." }],
+		};
+
+		expect(resolveTranslation(post, ["fr", "ja"])?.title).toBe("こんにちは");
+	});
+
+	it("falls back to the post's default locale when nothing else matches", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [
+				{ locale: "en", title: "Hello", body: "..." },
+				{ locale: "ja", title: "こんにちは", body: "..." },
+			],
+		};
+
+		expect(resolveTranslation(post, ["fr", "de"])?.title).toBe("Hello");
+	});
+
+	it("returns null when no accepted locale matches and the post has no translations", () => {
+		const post: Post = { slug: "hello", defaultLocale: "en", translations: [] };
+
+		expect(resolveTranslation(post, ["fr", "de"])).toBeNull();
+	});
+
+	it("returns null when the default locale itself has no translation", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "ja", title: "こんにちは", body: "..." }],
+		};
+
+		expect(resolveTranslation(post, ["fr", "de"])).toBeNull();
+	});
+
+	it("falls back straight to the default locale when no locales are accepted", () => {
+		const post: Post = {
+			slug: "hello",
+			defaultLocale: "en",
+			translations: [{ locale: "en", title: "Hello", body: "..." }],
+		};
+
+		expect(resolveTranslation(post, [])?.title).toBe("Hello");
+	});
+});
