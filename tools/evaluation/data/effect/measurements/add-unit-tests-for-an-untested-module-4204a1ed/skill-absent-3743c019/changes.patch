+import { describe, expect, it } from "@jest/globals";
+import {
+	findExactMatch,
+	findLanguageMatch,
+	normalizeLocale,
+	type Post,
+	resolveTranslation,
+} from "./resolve-translation";
+
+function post(overrides: Partial<Post> = {}): Post {
+	return {
+		slug: "hello",
+		defaultLocale: "en",
+		translations: [],
+		...overrides,
+	};
+}
+
+describe("normalizeLocale", () => {
+	it("lowercases", () => {
+		expect(normalizeLocale("EN-US")).toBe("en-us");
+	});
+
+	it("trims whitespace", () => {
+		expect(normalizeLocale("  en-US  ")).toBe("en-us");
+	});
+});
+
+describe("findExactMatch", () => {
+	it("matches a translation with the identical locale", () => {
+		const en = { locale: "en-US", title: "Hi", body: "..." };
+		const p = post({ translations: [en] });
+
+		expect(findExactMatch(p, "en-US")).toBe(en);
+	});
+
+	it("matches case-insensitively", () => {
+		const en = { locale: "en-US", title: "Hi", body: "..." };
+		const p = post({ translations: [en] });
+
+		expect(findExactMatch(p, "EN-us")).toBe(en);
+	});
+
+	it("does not match a translation with only the same language subtag", () => {
+		const en = { locale: "en", title: "Hi", body: "..." };
+		const p = post({ translations: [en] });
+
+		expect(findExactMatch(p, "en-US")).toBeNull();
+	});
+
+	it("returns null when there is no translation at all", () => {
+		expect(findExactMatch(post(), "en-US")).toBeNull();
+	});
+});
+
+describe("findLanguageMatch", () => {
+	it("matches a translation sharing the language subtag regardless of region", () => {
+		const ja = { locale: "ja", title: "こんにちは", body: "..." };
+		const p = post({ translations: [ja] });
+
+		expect(findLanguageMatch(p, "ja-JP")).toBe(ja);
+	});
+
+	it("matches the other direction: a bare-language request reaches a regioned translation", () => {
+		const jaJP = { locale: "ja-JP", title: "こんにちは", body: "..." };
+		const p = post({ translations: [jaJP] });
+
+		expect(findLanguageMatch(p, "ja")).toBe(jaJP);
+	});
+
+	it("does not match a different language", () => {
+		const en = { locale: "en-US", title: "Hi", body: "..." };
+		const p = post({ translations: [en] });
+
+		expect(findLanguageMatch(p, "ja")).toBeNull();
+	});
+
+	it("returns null when there is no translation at all", () => {
+		expect(findLanguageMatch(post(), "ja")).toBeNull();
+	});
+});
+
+describe("resolveTranslation", () => {
+	it("prefers an exact match over a language-only match", () => {
+		const enUS = { locale: "en-US", title: "US", body: "..." };
+		const en = { locale: "en", title: "Generic", body: "..." };
+		const p = post({ translations: [en, enUS] });
+
+		expect(resolveTranslation(p, ["en-US"])).toBe(enUS);
+	});
+
+	it("falls back to a language-only match when no exact match exists", () => {
+		const ja = { locale: "ja", title: "こんにちは", body: "..." };
+		const p = post({ translations: [ja] });
+
+		expect(resolveTranslation(p, ["ja-JP"])).toBe(ja);
+	});
+
+	it("respects the caller's preference order across accepted locales", () => {
+		const fr = { locale: "fr", title: "Bonjour", body: "..." };
+		const de = { locale: "de", title: "Hallo", body: "..." };
+		const p = post({ translations: [de, fr] });
+
+		expect(resolveTranslation(p, ["fr", "de"])).toBe(fr);
+		expect(resolveTranslation(p, ["de", "fr"])).toBe(de);
+	});
+
+	it("prefers an exact match on a later-preferred locale over a language match on an earlier one", () => {
+		const enGB = { locale: "en-GB", title: "Generic English", body: "..." };
+		const frFR = { locale: "fr-FR", title: "Exact French", body: "..." };
+		const p = post({ translations: [enGB, frFR] });
+
+		expect(resolveTranslation(p, ["fr-CA", "fr-FR"])).toBe(frFR);
+	});
+
+	it("falls back to the post's default locale when no accepted locale matches", () => {
+		const en = { locale: "en", title: "Default", body: "..." };
+		const p = post({ defaultLocale: "en", translations: [en] });
+
+		expect(resolveTranslation(p, ["ja", "fr"])).toBe(en);
+	});
+
+	it("returns null when the post has no translations at all", () => {
+		const p = post({ translations: [] });
+
+		expect(resolveTranslation(p, ["en", "ja"])).toBeNull();
+	});
+
+	it("returns null when neither the accepted locales nor the default locale match", () => {
+		const de = { locale: "de", title: "Hallo", body: "..." };
+		const p = post({ defaultLocale: "en", translations: [de] });
+
+		expect(resolveTranslation(p, ["ja", "fr"])).toBeNull();
+	});
+
+	it("returns null when given no accepted locales and no default-locale translation", () => {
+		const de = { locale: "de", title: "Hallo", body: "..." };
+		const p = post({ defaultLocale: "en", translations: [de] });
+
+		expect(resolveTranslation(p, [])).toBeNull();
+	});
+});
