--- /dev/null
+++ b/src/session/redirect-path.ts
@@ -0,0 +1,28 @@
+const FALLBACK = "/";
+
+/**
+ * A `redirect` search param arrives from wherever `AuthenticatedLayout` put
+ * it — ultimately, from a URL a learner tapped, which makes it untrusted
+ * input in the same way a route param is. Accepting anything other than a
+ * same-app path here would let a crafted link bounce sign-in to an
+ * off-app address (a bare `//host` is protocol-relative) or back into
+ * `/sign-in` itself, which would just show the form again instead of
+ * completing the redirect.
+ */
+export function sanitizeRedirectPath(
+  raw: string | string[] | undefined,
+): string {
+  if (typeof raw !== "string") {
+    return FALLBACK;
+  }
+
+  if (!raw.startsWith("/") || raw.startsWith("//")) {
+    return FALLBACK;
+  }
+
+  if (raw === "/sign-in" || raw.startsWith("/sign-in/")) {
+    return FALLBACK;
+  }
+
+  return raw;
+}
