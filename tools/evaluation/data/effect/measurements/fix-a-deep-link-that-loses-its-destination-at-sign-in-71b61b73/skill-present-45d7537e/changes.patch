+import { render, screen } from "@testing-library/react-native";
+
+import type { Session } from "./session";
+import { AuthenticatedLayout } from "./authenticated-layout";
+
+const mockUsePathname = jest.fn();
+
+let mockSession: Session | null = null;
+let mockStatus: "loading" | "ready" = "ready";
+
+jest.mock("./session-context", () => ({
+  useSession: () => ({
+    session: mockSession,
+    status: mockStatus,
+    signIn: jest.fn(),
+    signOut: jest.fn(),
+  }),
+}));
+
+jest.mock("expo-router", () => ({
+  usePathname: () => mockUsePathname(),
+  Redirect: ({ href }: { href: unknown }) => {
+    // jest.mock's factory cannot reference an out-of-scope import, so `Text`
+    // is required lazily here instead.
+    // eslint-disable-next-line @typescript-eslint/no-require-imports
+    const { Text } = require("react-native");
+    return <Text testID="redirect">{JSON.stringify(href)}</Text>;
+  },
+  Stack: () => {
+    // eslint-disable-next-line @typescript-eslint/no-require-imports
+    const { Text } = require("react-native");
+    return <Text testID="stack" />;
+  },
+}));
+
+beforeEach(() => {
+  mockUsePathname.mockReset().mockReturnValue("/");
+  mockSession = null;
+  mockStatus = "ready";
+});
+
+describe("AuthenticatedLayout", () => {
+  it("shows a loading state while the session is resolving", async () => {
+    mockStatus = "loading";
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("loading-indicator")).toBeOnTheScreen();
+    expect(screen.queryByTestId("redirect")).toBeNull();
+  });
+
+  it("sends a signed-out learner to sign-in, carrying the path they meant to reach", async () => {
+    mockUsePathname.mockReturnValue("/decks/world-capitals");
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("redirect")).toHaveTextContent(
+      JSON.stringify({
+        pathname: "/sign-in",
+        params: { redirect: "/decks/world-capitals" },
+      }),
+    );
+  });
+
+  it("renders the signed-in stack once a session is present", async () => {
+    mockSession = { accountId: "account-1", email: "person@example.com" };
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("stack")).toBeOnTheScreen();
+    expect(screen.queryByTestId("redirect")).toBeNull();
+  });
+});
