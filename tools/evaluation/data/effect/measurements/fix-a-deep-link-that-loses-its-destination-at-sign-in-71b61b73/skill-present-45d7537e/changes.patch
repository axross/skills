+import { sanitizeRedirectPath } from "./redirect-path";
+
+describe("sanitizeRedirectPath", () => {
+  it("accepts a same-app path", () => {
+    expect(sanitizeRedirectPath("/decks/world-capitals")).toBe(
+      "/decks/world-capitals",
+    );
+  });
+
+  it.each([
+    ["undefined", undefined],
+    ["an empty string", ""],
+    ["a repeated-param array", ["/decks/a", "/decks/b"]],
+    ["a relative path missing the leading slash", "decks/world-capitals"],
+    ["a protocol-relative path", "//evil.example.com"],
+    ["the sign-in route itself", "/sign-in"],
+    ["a sign-in sub-route", "/sign-in/whatever"],
+  ])("falls back to the deck list for %s", (_label, raw) => {
+    expect(sanitizeRedirectPath(raw)).toBe("/");
+  });
+});
