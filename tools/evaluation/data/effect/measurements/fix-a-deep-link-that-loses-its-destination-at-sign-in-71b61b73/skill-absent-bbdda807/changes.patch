+import { render, screen } from "@testing-library/react-native";
+
+import { AuthenticatedLayout } from "./authenticated-layout";
+
+const mockUseSession = jest.fn();
+const mockUsePathname = jest.fn();
+
+jest.mock("./session-context", () => ({
+  useSession: () => mockUseSession(),
+}));
+
+jest.mock("expo-router", () => {
+  const actual = jest.requireActual("expo-router");
+  const { Text } = jest.requireActual("react-native");
+  return {
+    ...actual,
+    usePathname: () => mockUsePathname(),
+    // The real `Redirect` needs a router context this test doesn't set up —
+    // stand in with something that surfaces the `href` it was given instead.
+    Redirect: ({ href }: { href: unknown }) => (
+      <Text testID="redirect">{JSON.stringify(href)}</Text>
+    ),
+  };
+});
+
+beforeEach(() => {
+  mockUseSession.mockReset();
+  mockUsePathname.mockReset().mockReturnValue("/");
+});
+
+describe("AuthenticatedLayout", () => {
+  it("sends a signed-out learner to sign-in with the path they were on", async () => {
+    mockUsePathname.mockReturnValue("/decks/world-capitals");
+    mockUseSession.mockReturnValue({ session: null, status: "ready" });
+
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("redirect")).toHaveTextContent(
+      JSON.stringify({
+        pathname: "/sign-in",
+        params: { redirect: "/decks/world-capitals" },
+      }),
+    );
+  });
+});
