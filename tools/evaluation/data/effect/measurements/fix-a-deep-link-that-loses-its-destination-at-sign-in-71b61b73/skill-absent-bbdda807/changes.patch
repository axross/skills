@@ -0,0 +1,29 @@
+import { resolvePostSignInRedirect } from "./post-sign-in-redirect";
+
+describe("resolvePostSignInRedirect", () => {
+  it("returns the requested path when it's a same-app path", () => {
+    expect(resolvePostSignInRedirect("/decks/abc123")).toBe("/decks/abc123");
+  });
+
+  it("falls back to the deck list when there's no redirect", () => {
+    expect(resolvePostSignInRedirect(undefined)).toBe("/");
+  });
+
+  it("falls back to the deck list for a repeated query param", () => {
+    expect(resolvePostSignInRedirect(["/decks/abc123", "/decks/xyz789"])).toBe(
+      "/",
+    );
+  });
+
+  it("falls back to the deck list for a path that doesn't start with a slash", () => {
+    expect(resolvePostSignInRedirect("decks/abc123")).toBe("/");
+  });
+
+  it("falls back to the deck list for a protocol-relative path", () => {
+    expect(resolvePostSignInRedirect("//evil.example.com")).toBe("/");
+  });
+
+  it("falls back to the deck list rather than looping back to sign-in", () => {
+    expect(resolvePostSignInRedirect("/sign-in")).toBe("/");
+  });
+});
