@@ -0,0 +1,29 @@
+const DEFAULT_REDIRECT = "/";
+
+/**
+ * `/sign-in`'s `redirect` search param names where to send a learner once
+ * they're signed in — set by `AuthenticatedLayout` when a deep link (an
+ * email's link to one particular deck, for instance) reached a signed-out
+ * app, so sign-in can finish the trip instead of dropping them at the deck
+ * list. It arrives as untrusted URL input, so anything that isn't an
+ * in-app path — missing, a bare `//host` (protocol-relative, and so
+ * external), or `/sign-in` itself — falls back to the default rather than
+ * risking a redirect loop or a destination outside the app.
+ */
+export function resolvePostSignInRedirect(
+  raw: string | string[] | undefined,
+): string {
+  if (typeof raw !== "string") {
+    return DEFAULT_REDIRECT;
+  }
+
+  if (!raw.startsWith("/") || raw.startsWith("//")) {
+    return DEFAULT_REDIRECT;
+  }
+
+  if (raw === "/sign-in") {
+    return DEFAULT_REDIRECT;
+  }
+
+  return raw;
+}
