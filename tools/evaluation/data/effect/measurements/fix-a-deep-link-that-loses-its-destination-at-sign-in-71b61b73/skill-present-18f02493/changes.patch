+import { normalizeRedirectPath } from "./redirect-path";
+
+describe("normalizeRedirectPath", () => {
+  it("accepts an in-app path", () => {
+    expect(normalizeRedirectPath("/decks/world-capitals")).toBe(
+      "/decks/world-capitals",
+    );
+  });
+
+  it.each([
+    ["undefined", undefined],
+    ["a repeated-segment array", ["/decks/world-capitals", "extra"]],
+    ["an empty string", ""],
+    ["a path missing its leading slash", "decks/world-capitals"],
+    ["a protocol-relative path", "//evil.example.com/decks/world-capitals"],
+    ["an absolute URL", "https://evil.example.com/decks/world-capitals"],
+  ])("rejects %s", (_label, raw) => {
+    expect(normalizeRedirectPath(raw)).toBeNull();
+  });
+});
