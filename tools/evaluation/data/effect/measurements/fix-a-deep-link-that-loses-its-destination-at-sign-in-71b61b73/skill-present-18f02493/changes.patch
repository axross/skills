+import { render, screen } from "@testing-library/react-native";
+
+import { AuthenticatedLayout } from "./authenticated-layout";
+
+const mockUseSession = jest.fn();
+const mockRedirect = jest.fn();
+const mockStack = jest.fn();
+
+jest.mock("./session-context", () => ({
+  useSession: () => mockUseSession(),
+}));
+
+jest.mock("expo-router", () => ({
+  usePathname: () => "/decks/world-capitals",
+  Redirect: ({ href }: { href: unknown }) => {
+    mockRedirect(href);
+    return null;
+  },
+  Stack: () => {
+    mockStack();
+    return null;
+  },
+}));
+
+beforeEach(() => {
+  mockUseSession.mockReset();
+  mockRedirect.mockReset();
+  mockStack.mockReset();
+});
+
+describe("AuthenticatedLayout", () => {
+  it("shows a loading screen while the session is still resolving", async () => {
+    mockUseSession.mockReturnValue({ session: undefined, status: "loading" });
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("loading-indicator")).toBeOnTheScreen();
+    expect(mockRedirect).not.toHaveBeenCalled();
+    expect(mockStack).not.toHaveBeenCalled();
+  });
+
+  it("sends a signed-out learner to sign-in, carrying the path they were trying to reach", async () => {
+    mockUseSession.mockReturnValue({ session: null, status: "ready" });
+    await render(<AuthenticatedLayout />);
+
+    expect(mockRedirect).toHaveBeenCalledWith({
+      pathname: "/sign-in",
+      params: { redirect: "/decks/world-capitals" },
+    });
+  });
+
+  it("renders the signed-in stack once a session exists", async () => {
+    mockUseSession.mockReturnValue({
+      session: { accountId: "local-abc123", email: "person@example.com" },
+      status: "ready",
+    });
+    await render(<AuthenticatedLayout />);
+
+    expect(mockStack).toHaveBeenCalled();
+    expect(mockRedirect).not.toHaveBeenCalled();
+  });
+});
