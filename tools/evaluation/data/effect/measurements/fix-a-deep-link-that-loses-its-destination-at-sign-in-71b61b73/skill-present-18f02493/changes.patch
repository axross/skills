+++ b/src/session/redirect-path.ts
@@ -0,0 +1,21 @@
+/**
+ * A sign-in redirect target arrives as an untrusted `redirect` query
+ * parameter — a deep link built the URL, so it's normalized here before
+ * `SignInScreen` trusts it to send a learner anywhere beyond the deck list.
+ * Only a path within this app's own routes is honored: a leading-slash
+ * segment, not an absolute URL, a protocol-relative one, or anything else a
+ * crafted link could use to send a signed-in learner elsewhere.
+ */
+export function normalizeRedirectPath(
+  raw: string | string[] | undefined,
+): string | null {
+  if (typeof raw !== "string") {
+    return null;
+  }
+
+  if (!raw.startsWith("/") || raw.startsWith("//")) {
+    return null;
+  }
+
+  return raw;
+}
