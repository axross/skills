index 0000000..637e315
--- /dev/null
+++ b/src/session/redirect-target.ts
@@ -0,0 +1,16 @@
+/**
+ * Only an internal path is safe to send a learner to after signing in.
+ * Anything else — no `redirect` param, or one that isn't rooted at `/`
+ * (including a protocol-relative `//host` a URL parser would read as one) —
+ * falls back to the deck list rather than being handed to the router
+ * unchecked.
+ */
+export function sanitizeRedirectTarget(
+  value: string | string[] | undefined,
+): string {
+  const target = Array.isArray(value) ? value[0] : value;
+  if (!target || !target.startsWith("/") || target.startsWith("//")) {
+    return "/";
+  }
+  return target;
+}
