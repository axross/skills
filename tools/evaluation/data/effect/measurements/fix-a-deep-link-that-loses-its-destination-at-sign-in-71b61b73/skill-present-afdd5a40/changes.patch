+++ b/src/session/redirect-target.spec.ts
@@ -0,0 +1,27 @@
+import { sanitizeRedirectTarget } from "./redirect-target";
+
+describe("sanitizeRedirectTarget", () => {
+  it("passes through an internal path", () => {
+    expect(sanitizeRedirectTarget("/decks/world-capitals")).toBe(
+      "/decks/world-capitals",
+    );
+  });
+
+  it("takes the first value when given an array", () => {
+    expect(sanitizeRedirectTarget(["/decks/world-capitals", "/settings"])).toBe(
+      "/decks/world-capitals",
+    );
+  });
+
+  it("falls back to the deck list when there is no value", () => {
+    expect(sanitizeRedirectTarget(undefined)).toBe("/");
+  });
+
+  it("falls back to the deck list for a protocol-relative target", () => {
+    expect(sanitizeRedirectTarget("//evil.example.com")).toBe("/");
+  });
+
+  it("falls back to the deck list for a target that isn't rooted at /", () => {
+    expect(sanitizeRedirectTarget("https://evil.example.com")).toBe("/");
+  });
+});
