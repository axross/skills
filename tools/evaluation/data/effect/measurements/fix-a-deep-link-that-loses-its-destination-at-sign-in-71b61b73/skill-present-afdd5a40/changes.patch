+import { render, screen } from "@testing-library/react-native";
+
+import { AuthenticatedLayout } from "./authenticated-layout";
+
+const mockUseSession = jest.fn();
+
+jest.mock("./session-context", () => ({
+  useSession: () => mockUseSession(),
+}));
+
+jest.mock("expo-router", () => {
+  // eslint-disable-next-line @typescript-eslint/no-require-imports -- jest.mock factories can't reference out-of-scope imports
+  const { Text } = require("react-native");
+  return {
+    usePathname: () => "/decks/world-capitals",
+    Redirect: ({ href }: { href: unknown }) => (
+      <Text testID="redirect">{JSON.stringify(href)}</Text>
+    ),
+    Stack: () => <Text testID="stack" />,
+  };
+});
+
+beforeEach(() => {
+  mockUseSession.mockReset();
+});
+
+describe("AuthenticatedLayout", () => {
+  it("shows a loading state while the session is resolving", async () => {
+    mockUseSession.mockReturnValue({ session: null, status: "loading" });
+
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("loading-indicator")).toBeTruthy();
+  });
+
+  it("redirects to sign-in with the current path when signed out", async () => {
+    mockUseSession.mockReturnValue({ session: null, status: "ready" });
+
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("redirect")).toHaveTextContent(
+      JSON.stringify({
+        pathname: "/sign-in",
+        params: { redirect: "/decks/world-capitals" },
+      }),
+    );
+  });
+
+  it("renders the signed-in stack once a session is present", async () => {
+    mockUseSession.mockReturnValue({
+      session: { accountId: "local-1", email: "person@example.com" },
+      status: "ready",
+    });
+
+    await render(<AuthenticatedLayout />);
+
+    expect(screen.getByTestId("stack")).toBeTruthy();
+  });
+});
