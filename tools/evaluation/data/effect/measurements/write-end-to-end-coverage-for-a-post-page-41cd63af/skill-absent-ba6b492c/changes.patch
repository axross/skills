index 0000000..abd0763
--- /dev/null
+++ b/e2e/post.spec.ts
@@ -0,0 +1,50 @@
+import { expect, test } from "@playwright/test";
+
+// One behavior per test, read as a reader driving the browser — see
+// playwright.config.ts for the server these run against.
+
+test.describe("reader's browser matches a post's translation exactly", () => {
+	test.use({ locale: "en-US" });
+
+	test("renders that translation", async ({ page }) => {
+		await page.goto("/posts/hello-world");
+
+		await expect(page.getByRole("heading", { level: 1 })).toHaveText(
+			"Hello, world",
+		);
+		await expect(page.getByText("A short note about this blog.")).toBeVisible();
+	});
+});
+
+test.describe("reader's browser matches none of a post's translations", () => {
+	test.use({ locale: "fr-FR" });
+
+	test("falls back to the post's default-locale translation", async ({
+		page,
+	}) => {
+		await page.goto("/posts/hello-world");
+
+		await expect(page.getByRole("heading", { level: 1 })).toHaveText(
+			"はじめまして",
+		);
+	});
+
+	test("falls back to the default-locale translation even when it is tagged with a bare language subtag", async ({
+		page,
+	}) => {
+		const response = await page.goto("/posts/on-writing-in-two-languages");
+
+		expect(response?.status()).toBe(200);
+		await expect(page.getByRole("heading", { level: 1 })).toHaveText(
+			"二言語で書くということ",
+		);
+	});
+});
+
+test("a post with no translations at all renders the not-found page", async ({
+	page,
+}) => {
+	const response = await page.goto("/posts/draft-notes");
+
+	expect(response?.status()).toBe(404);
+});
diff --git a/shared/resolve-translation.spec.ts b/shared/resolve-translation.spec.ts
new file mode 100644
index 0000000..f0280f8
--- /dev/null
+++ b/shared/resolve-translation.spec.ts
@@ -0,0 +1,76 @@
+import { describe, expect, it } from "@jest/globals";
+import type { Post } from "./resolve-translation";
+import { resolveTranslation } from "./resolve-translation";
+
+function post(overrides: Partial<Post> = {}): Post {
+	return {
+		slug: "test-post",
+		defaultLocale: "ja-JP",
+		translations: [
+			{ locale: "ja-JP", title: "はじめまして", body: "..." },
+			{ locale: "en-US", title: "Hello, world", body: "..." },
+		],
+		...overrides,
+	};
+}
+
+describe("resolveTranslation", () => {
+	it("prefers an exact match over a language-only match", () => {
+		const p = post({
+			translations: [
+				{ locale: "en", title: "English (any region)", body: "..." },
+				{ locale: "en-GB", title: "English (UK)", body: "..." },
+			],
+		});
+
+		expect(resolveTranslation(p, ["en-GB"])?.title).toBe("English (UK)");
+	});
+
+	it("falls back to a language-only match when no accepted locale matches exactly", () => {
+		const p = post();
+
+		expect(resolveTranslation(p, ["en-GB"])?.title).toBe("Hello, world");
+	});
+
+	it("honors the accepted locales' preference order", () => {
+		const p = post();
+
+		expect(resolveTranslation(p, ["fr-FR", "en-US"])?.title).toBe(
+			"Hello, world",
+		);
+	});
+
+	it("falls back to the post's default locale when no accepted locale matches at all", () => {
+		const p = post();
+
+		expect(resolveTranslation(p, ["fr-FR"])?.title).toBe("はじめまして");
+	});
+
+	it("falls back to the default locale's translation by language when it is tagged with a bare language subtag", () => {
+		const p = post({
+			defaultLocale: "ja-JP",
+			translations: [
+				{ locale: "ja", title: "二言語で書くということ", body: "..." },
+			],
+		});
+
+		expect(resolveTranslation(p, ["fr-FR"])?.title).toBe(
+			"二言語で書くということ",
+		);
+	});
+
+	it("returns null when the post has no translations at all", () => {
+		const p = post({ translations: [] });
+
+		expect(resolveTranslation(p, ["en-US"])).toBeNull();
+	});
+
+	it("returns null when the post's default locale has no translation, exact or by language", () => {
+		const p = post({
+			defaultLocale: "de-DE",
+			translations: [{ locale: "en-US", title: "Hello, world", body: "..." }],
+		});
+
+		expect(resolveTranslation(p, ["fr-FR"])).toBeNull();
+	});
+});
