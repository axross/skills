+import { expect, type Page, test } from "@playwright/test";
+
+// One behavior per test, read as a reader driving the browser — see
+// playwright.config.ts for the server these run against. Locale fallback is
+// exercised through the Accept-Language header, matching what a real
+// browser sends; see shared/resolve-translation.ts for the resolution order
+// these tests hold to.
+
+/**
+ * Rewrites every request's `Accept-Language` header to `acceptLanguage`,
+ * standing in for a reader whose browser sends that value. Routed rather than
+ * set via the context's `extraHTTPHeaders` option so each test controls its
+ * own value independently.
+ */
+async function setAcceptLanguage(page: Page, acceptLanguage: string) {
+	await page.route("**/*", (route) => {
+		const headers = route.request().headers();
+		headers["accept-language"] = acceptLanguage;
+		route.continue({ headers });
+	});
+}
+
+test("renders the translation matching the reader's exact locale", async ({
+	page,
+}) => {
+	await setAcceptLanguage(page, "en-US,en;q=0.9");
+	await page.goto("/posts/hello-world");
+
+	const article = page.getByRole("article");
+	await expect(article.getByRole("heading", { level: 1 })).toHaveText(
+		"Hello, world",
+	);
+	await expect(
+		article.getByText("A short note about this blog."),
+	).toBeVisible();
+});
+
+test("renders a translation matched by language when no exact-locale translation exists", async ({
+	page,
+}) => {
+	await setAcceptLanguage(page, "ja-JP");
+	await page.goto("/posts/on-writing-in-two-languages");
+
+	const article = page.getByRole("article");
+	await expect(article.getByRole("heading", { level: 1 })).toHaveText(
+		"二言語で書くということ",
+	);
+});
+
+test("falls back to the post's default-locale translation when none of the reader's locales match", async ({
+	page,
+}) => {
+	await setAcceptLanguage(page, "fr-FR,fr;q=0.9");
+	await page.goto("/posts/hello-world");
+
+	const article = page.getByRole("article");
+	await expect(article.getByRole("heading", { level: 1 })).toHaveText(
+		"はじめまして",
+	);
+});
+
+test("visiting a post with no translations at all renders the not-found page", async ({
+	page,
+}) => {
+	const response = await page.goto("/posts/draft-notes");
+
+	expect(response?.status()).toBe(404);
+});
