+class UnsafeDeployHookUrlError extends Error {}
+
+// Ranges an author-supplied deployHookUrl must never resolve to: loopback,
+// the RFC 1918 / ULA private ranges, link-local (which is also where the
+// AWS/GCP/Azure cloud-metadata endpoint lives), and multicast. Node's
+// BlockList matches an IPv4-mapped IPv6 address against an "ipv4" subnet
+// when checked as "ipv6", so one list covers both families.
+const RESERVED_ADDRESSES = new BlockList();
+RESERVED_ADDRESSES.addSubnet("0.0.0.0", 8, "ipv4");
+RESERVED_ADDRESSES.addSubnet("10.0.0.0", 8, "ipv4");
+RESERVED_ADDRESSES.addSubnet("127.0.0.0", 8, "ipv4");
+RESERVED_ADDRESSES.addSubnet("169.254.0.0", 16, "ipv4");
+RESERVED_ADDRESSES.addSubnet("172.16.0.0", 12, "ipv4");
+RESERVED_ADDRESSES.addSubnet("192.168.0.0", 16, "ipv4");
+RESERVED_ADDRESSES.addSubnet("224.0.0.0", 4, "ipv4");
+RESERVED_ADDRESSES.addSubnet("::1", 128, "ipv6");
+RESERVED_ADDRESSES.addSubnet("fc00::", 7, "ipv6");
+RESERVED_ADDRESSES.addSubnet("fe80::", 10, "ipv6");
+
+function isReservedAddress(address: string): boolean {
+  const version = isIP(address);
+  if (version === 4) return RESERVED_ADDRESSES.check(address, "ipv4");
+  if (version === 6) return RESERVED_ADDRESSES.check(address, "ipv6");
+  return true;
+}
+
+/**
+ * A site's deployHookUrl is plain text an author fills in themselves, so it
+ * has to be treated the same as any other user-controlled fetch target: an
+ * allowlist of hosts isn't possible (it's meant to point at whatever static
+ * host the customer happens to use), so this validates the *resolved*
+ * address instead of the URL string, on every attempt — a rejected first
+ * lookup shouldn't be bypassable by a DNS record that changes before the
+ * retry (DNS rebinding).
+ */
+async function assertSafeDeployHookUrl(rawUrl: string): Promise<URL> {
+  let url: URL;
+  try {
+    url = new URL(rawUrl);
+  } catch {
+    throw new UnsafeDeployHookUrlError(`"${rawUrl}" is not a valid URL.`);
+  }
+
+  if (url.protocol !== "https:" && url.protocol !== "http:") {
+    throw new UnsafeDeployHookUrlError(`"${url.protocol}" is not an allowed protocol.`);
+  }
+
+  const hostname = url.hostname.toLowerCase();
+  if (hostname === "localhost" || hostname.endsWith(".internal")) {
+    throw new UnsafeDeployHookUrlError(`"${hostname}" is not a publicly routable host.`);
+  }
+
+  // A literal IPv6 host keeps its brackets in `URL#hostname` (e.g. "[::1]");
+  // strip them so isIP() recognizes it as the address it is instead of
+  // falling through to a DNS lookup that was never going to happen.
+  const literalAddress =
+    hostname.startsWith("[") && hostname.endsWith("]") ? hostname.slice(1, -1) : hostname;
+
+  const addresses = isIP(literalAddress)
+    ? [literalAddress]
+    : (await lookup(hostname, { all: true })).map((entry) => entry.address);
+
+  if (addresses.length === 0 || addresses.some(isReservedAddress)) {
+    throw new UnsafeDeployHookUrlError(`"${hostname}" does not resolve to a public address.`);
+  }
+
+  return url;
+}
+
