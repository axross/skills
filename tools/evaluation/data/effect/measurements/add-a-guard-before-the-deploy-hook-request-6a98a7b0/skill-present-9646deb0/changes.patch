+// `deployHookUrl` is a plain text field a customer fills in themselves, so
+// every call here is an outbound request to a URL this server did not
+// choose. The checks below turn that into a request to a host confirmed
+// public at request time, not just a URL that merely parses — see
+// docs/deploy-hooks.md for the reasoning and the list of what's blocked.
+
+const RESERVED_IPV4_CIDRS = [
+  "0.0.0.0/8", // "this network"
+  "10.0.0.0/8", // RFC 1918
+  "100.64.0.0/10", // carrier-grade NAT
+  "127.0.0.0/8", // loopback
+  "169.254.0.0/16", // link-local, incl. cloud metadata (169.254.169.254)
+  "172.16.0.0/12", // RFC 1918
+  "192.0.0.0/24", // IETF protocol assignments
+  "192.168.0.0/16", // RFC 1918
+  "198.18.0.0/15", // benchmarking
+  "224.0.0.0/4", // multicast
+  "240.0.0.0/4", // reserved
+];
+
+const INTERNAL_HOSTNAME_SUFFIXES = [".internal", ".localhost"];
+const INTERNAL_HOSTNAMES = new Set(["localhost", "metadata.google.internal"]);
+
+function ipv4ToInt(ip: string): number {
+  const octets = ip.split(".").map(Number);
+  return octets.reduce((acc, octet) => (acc << 8) + octet, 0) >>> 0;
+}
+
+function isReservedIpv4(ip: string): boolean {
+  const target = ipv4ToInt(ip);
+  return RESERVED_IPV4_CIDRS.some((cidr) => {
+    const [range, bitsStr] = cidr.split("/");
+    const bits = Number(bitsStr);
+    const mask = bits === 0 ? 0 : (~0 << (32 - bits)) >>> 0;
+    return (target & mask) === (ipv4ToInt(range) & mask);
+  });
+}
+
+function isReservedIpv6(ip: string): boolean {
+  const normalized = ip.toLowerCase();
+
+  // An IPv4-mapped or IPv4-compatible IPv6 address carries the real address
+  // it represents in its final segment (e.g. "::ffff:169.254.169.254") —
+  // check that embedded address rather than the wrapper.
+  const mappedIpv4 = normalized.match(/(?:^|:)(\d+\.\d+\.\d+\.\d+)$/)?.[1];
+  if (mappedIpv4) return isReservedIpv4(mappedIpv4);
+
+  if (normalized === "::" || normalized === "::1") return true; // unspecified / loopback
+
+  const firstHextet = normalized.startsWith("::")
+    ? 0
+    : parseInt(normalized.split(":")[0] || "0", 16);
+
+  if (firstHextet >= 0xfe80 && firstHextet <= 0xfebf) return true; // link-local, fe80::/10
+  if (firstHextet >= 0xfc00 && firstHextet <= 0xfdff) return true; // unique local, fc00::/7 (incl. Azure/AWS metadata)
+  if (firstHextet >= 0xff00 && firstHextet <= 0xffff) return true; // multicast, ff00::/8
+
+  return false;
+}
+
+function isReservedIp(ip: string): boolean {
+  const family = isIP(ip);
+  if (family === 4) return isReservedIpv4(ip);
+  if (family === 6) return isReservedIpv6(ip);
+  return true; // not a recognizable IP literal — fail closed
+}
+
+// Thrown for anything that makes this call unsafe rather than merely
+// unreliable — an unresolvable/reserved host, a disallowed scheme, or a
+// redirect we won't follow blind. None of these are worth retrying: the
+// retry loop treats this class as a reason to give up immediately instead
+// of spending its remaining attempts.
+class DeployHookSecurityError extends Error {}
+
+/**
+ * Confirms `url` is an `http(s)` URL whose host resolves only to public,
+ * routable addresses. Throws `DeployHookSecurityError` otherwise. Resolves
+ * fresh on every call (each retry calls this again) rather than caching,
+ * since the whole point is to catch a host whose DNS answer has changed
+ * since the last look.
+ */
+async function assertSafeDeployHookUrl(url: string): Promise<URL> {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    throw new DeployHookSecurityError(`"${url}" is not a valid URL.`);
+  }
+
+  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+    throw new DeployHookSecurityError(`"${parsed.protocol}" is not an allowed scheme.`);
+  }
+
+  // The WHATWG URL parser keeps the brackets around an IPv6 literal in
+  // `.hostname` (e.g. "[::1]") — strip them so IP checks below see the bare
+  // address `net.isIP` and `dns.lookup` expect.
+  const hostname = parsed.hostname.toLowerCase().replace(/^\[|\]$/g, "");
+  if (
+    INTERNAL_HOSTNAMES.has(hostname) ||
+    INTERNAL_HOSTNAME_SUFFIXES.some((suffix) => hostname.endsWith(suffix))
+  ) {
+    throw new DeployHookSecurityError(`"${hostname}" is not an allowed host.`);
+  }
+
+  const literalIpFamily = isIP(hostname);
+  const addresses =
+    literalIpFamily !== 0
+      ? [hostname]
+      : await dns
+          .lookup(hostname, { all: true, verbatim: true })
+          .then((records) => records.map((record) => record.address));
+
+  if (addresses.length === 0 || addresses.some(isReservedIp)) {
+    throw new DeployHookSecurityError(`"${hostname}" does not resolve to a public address.`);
+  }
+
+  return parsed;
+}
