+/**
+ * Address ranges no deploy hook should ever be allowed to reach: loopback,
+ * the RFC1918 and CGNAT private ranges, link-local (which is also where a
+ * cloud's instance-metadata endpoint lives — 169.254.169.254 on AWS/GCP/
+ * Azure alike), and the multicast/reserved space above it. `deployHookUrl`
+ * is a plain text field a customer fills in, so this list is what stands
+ * between "publish" and an attacker using this API as a proxy into whatever
+ * network it happens to run on.
+ */
+const FORBIDDEN_ADDRESSES = new BlockList();
+for (const [address, prefix] of [
+  ["0.0.0.0", 8], // "this network"
+  ["10.0.0.0", 8], // RFC1918
+  ["100.64.0.0", 10], // carrier-grade NAT
+  ["127.0.0.0", 8], // loopback
+  ["169.254.0.0", 16], // link-local, incl. cloud metadata endpoints
+  ["172.16.0.0", 12], // RFC1918
+  ["192.168.0.0", 16], // RFC1918
+  ["224.0.0.0", 4], // multicast
+  ["240.0.0.0", 4], // reserved
+] as const) {
+  FORBIDDEN_ADDRESSES.addSubnet(address, prefix, "ipv4");
+}
+for (const [address, prefix] of [
+  ["::1", 128], // loopback
+  ["::", 128], // unspecified
+  ["64:ff9b::", 96], // NAT64 well-known prefix — resolves through to an IPv4 target
+  ["fc00::", 7], // unique local (includes AWS's fd00:ec2::254 metadata address)
+  ["fe80::", 10], // link-local
+  ["ff00::", 8], // multicast
+] as const) {
+  FORBIDDEN_ADDRESSES.addSubnet(address, prefix, "ipv6");
+}
+
+export class UnsafeDeployHookUrlError extends Error {}
+
