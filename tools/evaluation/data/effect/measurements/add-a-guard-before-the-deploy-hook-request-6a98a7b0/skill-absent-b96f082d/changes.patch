+function stripBrackets(hostname: string): string {
+  return hostname.startsWith("[") && hostname.endsWith("]") ? hostname.slice(1, -1) : hostname;
+}
+
+function isForbiddenAddress(address: string): boolean {
+  if (isIPv4(address)) return FORBIDDEN_ADDRESSES.check(address, "ipv4");
+  if (isIPv6(address)) return FORBIDDEN_ADDRESSES.check(address, "ipv6");
+  return true; // an address net.isIP doesn't recognize is not one we trust
+}
+
+/**
+ * Parses and resolves a candidate deploy hook URL and throws
+ * `UnsafeDeployHookUrlError` unless every address it resolves to is
+ * ordinary public internet. Called before the initial request and again
+ * before following any redirect, since a URL that resolves safely once can
+ * still point a redirect at something that doesn't.
+ */
+export async function assertSafeDeployHookUrl(rawUrl: string): Promise<URL> {
+  let url: URL;
+  try {
+    url = new URL(rawUrl);
+  } catch {
+    throw new UnsafeDeployHookUrlError(`"${rawUrl}" is not a valid URL.`);
+  }
+
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    throw new UnsafeDeployHookUrlError(`"${url.protocol}" is not an allowed deploy hook scheme.`);
+  }
+
+  if (url.username || url.password) {
+    throw new UnsafeDeployHookUrlError("A deploy hook URL may not carry credentials.");
+  }
+
+  const hostname = stripBrackets(url.hostname);
+  if (hostname === "localhost") {
+    throw new UnsafeDeployHookUrlError('"localhost" is not an allowed deploy hook host.');
+  }
+
+  let addresses: string[];
+  try {
+    addresses = (await dns.lookup(hostname, { all: true })).map((result) => result.address);
+  } catch {
+    throw new UnsafeDeployHookUrlError(`"${hostname}" could not be resolved.`);
+  }
+
+  if (addresses.length === 0 || addresses.some(isForbiddenAddress)) {
+    throw new UnsafeDeployHookUrlError(`"${hostname}" resolves to an address this app won't call.`);
+  }
+
+  return url;
+}
+
+function isRedirect(response: Response): boolean {
+  return response.status >= 300 && response.status < 400 && response.headers.has("location");
+}
+
+/**
+ * Follows redirects itself instead of letting `fetch` do it, re-checking
+ * every hop with `assertSafeDeployHookUrl` first. A hook that resolves
+ * safely can still answer with a 302 to an internal address, and `fetch`'s
+ * own redirect handling would follow that without a second look.
+ */
+async function postToSafeUrl(url: URL): Promise<Response> {
+  let current = url;
+  for (let hop = 0; ; hop += 1) {
+    const response = await fetch(current, { method: "POST", redirect: "manual" });
+    if (!isRedirect(response)) return response;
+    if (hop >= MAX_REDIRECTS) {
+      throw new UnsafeDeployHookUrlError(
+        `Deploy hook redirected more than ${MAX_REDIRECTS} times.`,
+      );
+    }
+    const location = response.headers.get("location") ?? "";
+    current = await assertSafeDeployHookUrl(new URL(location, current).toString());
+  }
+}
