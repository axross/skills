+// Every range here is a private, loopback, link-local, or otherwise
+// non-routable block from RFC 6890's special-purpose address registry —
+// including 169.254.169.254, the address every major cloud uses for instance
+// metadata (and the classic SSRF payload for stealing credentials off the
+// host making the request). A deploy hook that resolves into any of these is
+// reaching back into our own network, not out to a customer's static host.
+const BLOCKED_ADDRESSES = new BlockList();
+const BLOCKED_IPV4_SUBNETS: ReadonlyArray<readonly [string, number]> = [
+  ["0.0.0.0", 8], // "this" network
+  ["10.0.0.0", 8], // RFC 1918 private
+  ["100.64.0.0", 10], // carrier-grade NAT
+  ["127.0.0.0", 8], // loopback
+  ["169.254.0.0", 16], // link-local (cloud instance metadata lives here)
+  ["172.16.0.0", 12], // RFC 1918 private
+  ["192.0.0.0", 24], // IETF protocol assignments
+  ["192.0.2.0", 24], // documentation (TEST-NET-1)
+  ["192.88.99.0", 24], // deprecated 6to4 relay anycast
+  ["192.168.0.0", 16], // RFC 1918 private
+  ["198.18.0.0", 15], // benchmarking
+  ["198.51.100.0", 24], // documentation (TEST-NET-2)
+  ["203.0.113.0", 24], // documentation (TEST-NET-3)
+  ["224.0.0.0", 4], // multicast
+  ["240.0.0.0", 4], // reserved / broadcast
+];
+const BLOCKED_IPV6_SUBNETS: ReadonlyArray<readonly [string, number]> = [
+  ["::", 128], // unspecified
+  ["::1", 128], // loopback
+  ["fc00::", 7], // unique local
+  ["fe80::", 10], // link-local
+  ["2001:db8::", 32], // documentation
+];
+for (const [subnet, prefix] of BLOCKED_IPV4_SUBNETS)
+  BLOCKED_ADDRESSES.addSubnet(subnet, prefix, "ipv4");
+for (const [subnet, prefix] of BLOCKED_IPV6_SUBNETS)
+  BLOCKED_ADDRESSES.addSubnet(subnet, prefix, "ipv6");
+
+const IPV4_MAPPED_IPV6 = /^::ffff:(\d+\.\d+\.\d+\.\d+)$/i;
+
+function isBlockedAddress(address: string): boolean {
+  if (isIPv4(address)) return BLOCKED_ADDRESSES.check(address, "ipv4");
+
+  // `::ffff:a.b.c.d` carries an IPv4 address through an IPv6-shaped literal;
+  // net.BlockList checks it purely as IPv6 and would miss it, so unwrap it
+  // and check the embedded address against the IPv4 ranges too.
+  const mapped = IPV4_MAPPED_IPV6.exec(address);
+  if (mapped?.[1]) return BLOCKED_ADDRESSES.check(mapped[1], "ipv4");
+
+  return BLOCKED_ADDRESSES.check(address, "ipv6");
+}
+
+/**
+ * Rejects anything that isn't a plain http(s) URL pointed at a public
+ * address. The hostname is resolved here rather than left to `fetch`, so a
+ * name like `deploy.internal.example` can't hide a private-range IP behind
+ * DNS — this is the same reason a site operator can no longer be trusted to
+ * have typed a safe value themselves once this field is customer-editable.
+ *
+ * This doesn't close every gap: a hostname whose DNS record changes between
+ * this check and the `fetch` call below (DNS rebinding) would slip past it.
+ * That requires an attacker to control authoritative DNS for the hook's
+ * domain, which is a meaningfully harder bar than the plain
+ * point-it-at-169.254.169.254 case this exists to stop.
+ */
+async function assertSafeDeployHookUrl(url: string): Promise<void> {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    throw new Error("Deploy hook URL is not a valid URL.");
+  }
+
+  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+    throw new Error(`Deploy hook URL must be http or https, got "${parsed.protocol}".`);
+  }
+
+  // `URL#hostname` keeps the brackets on an IPv6 literal (e.g. "[::1]").
+  const hostname = parsed.hostname.replace(/^\[|\]$/g, "").toLowerCase();
+  if (hostname === "localhost" || hostname.endsWith(".localhost")) {
+    throw new Error("Deploy hook URL may not target localhost.");
+  }
+
+  // An IP literal (v4 or v6) needs no DNS resolution — checking it here
+  // rather than falling through to `dns.lookup` matters for IPv6 in
+  // particular, since a literal like "::1" is itself a valid-looking
+  // hostname and would otherwise get "resolved" (a no-op) instead of
+  // recognized as the loopback address it already is.
+  const addresses =
+    isIP(hostname) !== 0
+      ? [hostname]
+      : (await dns.lookup(hostname, { all: true })).map((entry) => entry.address);
+
+  for (const address of addresses) {
+    if (isBlockedAddress(address)) {
+      throw new Error(`Deploy hook URL resolves to a non-routable address (${address}).`);
+    }
+  }
+}
